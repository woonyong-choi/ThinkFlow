flow right
title "큐와 역압"
subtitle "생산이 소비보다 빠르면 큐가 차고, 가득 차면 생산을 막아야 한다"

box prod "생산자"
queue q "큐" slots=6
box cons "소비자"
on q q+1
prod -> q
q -> cons

step "큐가 차오른다" "1초마다 넣고 3초마다 꺼내면 칸이 하나씩 늘어 가득 찬다" for=10s
  track prod -> q "작업" at=500ms every=1s time=1s
  track q -> cons "꺼냄" at=3s every=3s time=1s tone=purple set="q-1@q"
