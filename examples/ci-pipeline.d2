# CI/CD: 분기(마름모), 되돌아가는 선, 사람, 외부 서비스
direction: right
dev: 개발자 {shape: person}
github: GitHub {
  pr: "Pull Request\n브랜치 → main"
  checks: "상태 검사\nrequired"
}
ci: CI 러너 {
  build: "빌드\ncargo build"
  test: "테스트\ncargo test"
  gate: 통과? {shape: diamond}
  build -> test -> gate
}
registry: 이미지 저장소 {shape: cylinder}
deploy: 배포 {
  staging: "스테이징\n카나리 5%"
  prod: "운영\n전체 반영"
  staging -> prod: 승인
}
slack: Slack {style.stroke-dash: 4}

dev -> github.pr: push
github.pr -> ci.build: 웹훅
ci.gate -> registry: 성공
ci.gate -> github.checks: 실패
github.checks -> dev: 알림
registry -> deploy.staging: 이미지
deploy.prod -> slack: 배포 완료

#@ step "성공 경로": 테스트를 통과하면 이미지가 운영까지 간다
#@   dev -> pr "feat: 판단기 재시도"
#@   show pr [pr/purple] #214 판단기 재시도 · +182 −40
#@   pr -> build "웹훅"
#@   show build `cargo build --release` (✓)
#@   build -> test
#@   show test 128 passed · 0 failed (✓)
#@   test -> gate : 모든 검사를 통과했다
#@   gate -> registry "saturn:1.4.0"
#@   show registry [tag/green] saturn:1.4.0 · 41 MB
#@   registry -> staging : 카나리로 5%에만 먼저 내보낸다
#@   show staging 오류율 0.02% · 10분 관찰 (✓)
#@   staging -> prod : 사람이 승인하면 전체에 반영한다
#@   prod -> slack "배포 완료"
#@ step "실패 경로": 테스트가 깨지면 PR에 되돌려 알린다
#@   dev -> pr "fix: 잠금 순서"
#@   pr -> build
#@   build -> test
#@   show test 127 passed · 1 failed (✗)
#@   show test [fail/orange] engine::lock_order
#@   test -> gate : 하나라도 실패하면 멈춘다
#@   gate -> checks "✗ test"
#@   show checks [required/orange] test 실패 (✗)
#@   checks -> dev "알림" : 개발자에게 실패한 테스트 이름을 보낸다
