# 브라우저 렌더링: 위에서 아래로, 두 입력이 합쳐지는 흐름
direction: down
net: 네트워크 {
  direction: right
  html: index.html {shape: document}
  css: style.css {shape: document}
}
parse: 파싱 {
  direction: right
  dom: "DOM\n요소 트리"
  cssom: "CSSOM\n규칙 트리"
}
render: "렌더 트리\n보이는 것만"
layout: "레이아웃\n위치와 크기"
paint: "페인트\n픽셀"
compose: "합성\nGPU 레이어"
net.html -> parse.dom: 토큰화
net.css -> parse.cssom
parse.dom -> render
parse.cssom -> render
render -> layout -> paint -> compose

#@ step "첫 화면": HTML과 CSS가 만나 픽셀이 된다
#@   html -> dom "<div class=card>" & css -> cssom ".card {…}" : HTML과 CSS는 따로 해석된다
#@   show dom html › body › div.card
#@   show cssom .card { display: flex }
#@   dom -> render & cssom -> render : 둘이 합쳐져 화면에 보일 것만 남는다
#@   show render div.card · display:flex
#@   render -> layout
#@   show layout x 24 · y 80 · 320×180
#@   layout -> paint
#@   paint -> compose : GPU가 층을 합쳐 화면에 올린다
#@ step "스크롤": transform만 바뀌면 합성만 다시 한다
#@   light compose : 레이아웃과 페인트를 건너뛰어 가장 싸다
#@   show compose [transform/green] translateY(-120px) (✓)
