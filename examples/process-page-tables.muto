flow right
title "프로세스마다 페이지 표가 있어 같은 페이지 번호가 다른 프레임으로 간다"
subtitle "두 프로세스의 페이지 0은 서로 다른 프레임이고, 읽기 전용 페이지 하나는 같은 프레임을 함께 쓴다"

grid a "프로세스 A의 페이지 표" rows=4 cols=3 {
  item ha "Page" row=0 col=0
  item hb "Frame" row=0 col=1
  item hc "Flags" row=0 col=2
  item a0 "0" row=1 col=0
  item af0 "3" row=1 col=1
  item ag0 "RW" row=1 col=2
  item a1 "1" row=2 col=0
  item af1 "6" row=2 col=1
  item ag1 "R" row=2 col=2
  item a2 "2" row=3 col=0
  item af2 "9" row=3 col=1
  item ag2 "RW" row=3 col=2
}
grid b "프로세스 B의 페이지 표" rows=3 cols=3 {
  item hd "Page" row=0 col=0
  item he "Frame" row=0 col=1
  item hf "Flags" row=0 col=2
  item b0 "0" row=1 col=0
  item bf0 "5" row=1 col=1
  item bg0 "RW" row=1 col=2
  item b1 "1" row=2 col=0
  item bf1 "6" row=2 col=1
  item bg1 "R" row=2 col=2
}
grid phys "물리 메모리" rows=5 {
  item fr3 "프레임 3 (A)" row=0
  item fr5 "프레임 5 (B)" row=1
  item fr6 "프레임 6 (A, B 공유)" row=2
  gap free "빈 프레임" count=2 row=3
  item fr9 "프레임 9 (A)" row=4
}
a.af0 -> phys.fr3
a.af1 -> phys.fr6
a.af2 -> phys.fr9
b.bf0 -> phys.fr5
b.bf1 -> phys.fr6

step "프로세스 A" "A의 페이지 0은 프레임 3, 페이지 1은 프레임 6으로 간다"
  light a.a0 a.af0
  a.af0 -> phys.fr3
  light a.a1 a.af1
  a.af1 -> phys.fr6
step "프로세스 B" "B의 페이지 0은 프레임 5다. 같은 페이지 번호가 다른 프레임으로 간다"
  light b.b0 b.bf0
  b.bf0 -> phys.fr5
step "공유 프레임" "읽기 전용(R) 페이지 1은 두 프로세스가 프레임 6을 함께 쓴다"
  light a.ag1 b.bg1
  a.af1 -> phys.fr6
  b.bf1 -> phys.fr6
