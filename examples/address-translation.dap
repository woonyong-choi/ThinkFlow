flow right
title "실행 시간 주소 변환은 가상 주소에 기준 주소를 더한다"
subtitle "기준·한계 레지스터 방식. 한계를 넘으면 더하기 전에 막는다"

grid cpu "CPU가 낸 가상 주소" {
  item va "0x0120"
}
grid regs "기준·한계 레지스터" rows=2 {
  item base "기준 0x4000" row=0
  item bound "한계 0x1000" row=1
}
box check "한계 검사" "가상 주소가 한계보다 작은가"
box add "⊕" shape=circle
grid mem "물리 주소" {
  item pa "0x4120"
}

cpu.va -> check
regs.bound -> check
check -> add "통과"
cpu.va -> add
regs.base -> add
add -> mem.pa

step "검사" "가상 주소 0x0120은 한계 0x1000보다 작아서 통과한다"
  light cpu.va regs.bound
  cpu.va -> check
  regs.bound -> check
  light check
step "더하기" "통과한 가상 주소에 기준 주소를 더한다"
  check -> add
  cpu.va -> add & regs.base -> add
  light add
step "물리 주소" "0x0120 + 0x4000 = 0x4120이 물리 주소다"
  add -> mem.pa
  light mem.pa
