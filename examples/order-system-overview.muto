flow right
title "복잡한 구성도"
subtitle "그룹 여섯 개(깊이 셋, 하늘과 주황 강조), 아이콘, 번호 선, 배지, 복제 개수, 값과 참조, 동시에 들어오는 흐름 둘, 오류와 정상과 주의를 한 장에 모았다"
width wide

group clients "클라이언트" {
  box web "웹" "브라우저" icon=desktop
  box app "앱" "iOS, Android" icon=mobile
}
group edge "엣지" {
  box cdn "CDN" "정적 캐시" icon=cdn
  box gw "게이트웨이" "인증, 라우팅" icon=apigw badge="GW"
}
group service "주문 서비스" icon=server fill=sky {
  box api "주문 API" "지금 처리 중" icon=server count=3
  group jobs "작업 처리" {
    box queue "큐" "대기" icon=mq
    group exec "실행기" {
      box worker "워커" "결제, 재고" icon=scaling badge="비동기"
    }
  }
}
group data "데이터" {
  store db "주 DB" "쓰기" icon=db
  store replica "복제 DB" "정상, 지연 0.2초" fill=green
  store cache "캐시" "적중률 하락 72%" fill=amber
}
group outer "외부" border=dashed fill=purple {
  external pay "결제사" "승인 오류 503" fill=red
  box mon "모니터링" "지표, 알림" icon=monitoring
}

value stock "재고" on=db from=120
value shown "앱 화면 재고" on=app ref=stock
value pending "처리 중" on=api
on api pending+1
on db pending-1, stock-1

web -> gw "주문" no=1
app -> gw "주문" no=2
gw -> cdn "정적" no=3
gw -> api "인증 뒤 전달" no=4
api -> queue "작업" no=5
queue -> worker no=6
api -> db "차감" no=7
worker -> db "기록" no=8
db -> replica "복제" dashed
db -> cache "무효화" dashed
worker -> pay "승인 요청" no=9
api -> mon "지표" dashed
pay -> mon "오류율" dashed

step "주문 하나" "웹 주문 하나가 게이트웨이와 API를 거쳐 재고를 줄인다"
  web -> gw tone=brand
  gw -> api
  light api
  say "API가 주문을 받으면 처리 중이 늘고 앱 화면 재고도 따라 바뀐다"
  api -> db tone=brand
step "주문이 몰릴 때" "웹과 앱에서 주문이 끊이지 않고 들어와 큐와 DB로 쏟아진다" for=8s
  track web -> gw -> api -> db every=0.9s tone=brand
  track app -> gw -> api -> queue -> worker every=0.8s at=0.3s tone=purple
  track gw -> cdn every=1.1s at=0.5s tone=green
  track worker -> db every=1s at=1s tone=gray
step "결제 오류" "워커가 결제사에 승인을 요청하지만 오류가 난다"
  worker -> pay
  light pay
  say "결제사가 503을 돌려준다"
