daphnis 2
title "가상 주소를 물리 주소로 바꾸기"
subtitle "8비트 주소의 윗부분은 페이지 표에서 프레임 번호로 바뀌고, 아랫부분은 그대로 이어진다"

box cpu "CPU" "load 0x4A"
grid va "가상 주소 (8비트)" cols=8 {
  item vpn "VPN (5비트)" col=0 cols=5
  item off "오프셋 (3비트)" col=5 cols=3
}
grid pt "페이지 표" rows=4 cols=3 {
  item hv "VPN" row=0 col=0
  item hf "프레임" row=0 col=1
  item hp "권한" row=0 col=2
  item v9 "9" row=1 col=0
  item f9 "4" row=1 col=1
  item p9 "RW" row=1 col=2
  item v12 "12" row=2 col=0
  item f12 "11" row=2 col=1
  item p12 "R" row=2 col=2
  gap rest "나머지 항목" row=3 col=0 cols=3 count=29
}
grid pa "물리 주소 (8비트)" cols=8 {
  item pfn "PFN (5비트)" col=0 cols=5
  item off "오프셋 (3비트)" col=5 cols=3
}

value loads "처리한 접근" on=cpu

cpu -> va "load 0x4A" no=1
va.vpn -> pt.v9 "VPN 9" no=2
pt.f9 -> pa.pfn "프레임 4" no=3
va.off -> pa.off "그대로" no=4

view graph down

scene "주소 구조" mode=static
  light va.vpn va.off pa.pfn pa.off

scene "주소 변환"
  cpu -> va time=600ms set="loads+1"
  light va.vpn
  va.vpn -> pt.v9 time=700ms
  light pt.f9 pt.p9
  pt.f9 -> pa.pfn time=700ms
  light pa.pfn
  va.off -> pa.off time=700ms
  light pa.off

scene "연속 접근" mode=loop keep="loads"
  track cpu -> va at=0s every=1500ms time=900ms set="loads+1"
