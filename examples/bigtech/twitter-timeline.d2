# Twitter 홈 타임라인: 쓰기 때 팔로워 타임라인에 넣기(fan-out)와 유명 계정 읽기 때 합치기 (공개 발표 기반 단순화)
direction: right

author: 작성자 {shape: person}
celebrity: "유명 계정\n팔로워 1억" {shape: person}
reader: 독자 {shape: person}

write: "쓰기 경로" {
  api: "Tweet API"
  tweets: "Manhattan\n트윗 저장" {shape: cylinder}
  fanout: "Fanout\n팔로워마다 넣기"
  graph: "팔로우 그래프" {shape: cylinder}
  api -> tweets
  api -> fanout
  fanout -> graph: 팔로워 목록
}

cache: "타임라인 캐시" {
  redis1: "Redis\n타임라인 샤드 1" {shape: cylinder}
  redis2: "Redis\n타임라인 샤드 2" {shape: cylinder}
}

read: "읽기 경로" {
  home: "Home Mixer\n타임라인 조립"
  ranker: "Ranker\n순위 모델"
  home -> ranker
}

author -> write.api: 트윗
celebrity -> write.api: 트윗
write.fanout -> cache.redis1
write.fanout -> cache.redis2
reader -> read.home: 홈 열기
read.home -> cache.redis1
read.home -> write.tweets: 유명 계정 트윗

#@ speed 3000ms
#@ step "일반 계정": 쓰는 순간 모든 팔로워의 타임라인 캐시에 트윗 id를 넣는다
#@   author -> api "오늘 배포 끝"
#@   api -> tweets "tweet 1789" & api -> fanout "tweet 1789"
#@   show tweets [new/blue] 1789 · 오늘 배포 끝
#@   fanout -> graph "팔로워?"
#@   graph -> fanout "팔로워 1,240명"
#@   fanout -> redis1 "1789" & fanout -> redis2 "1789" : 팔로워가 나뉜 샤드마다 동시에 넣는다
#@   show redis1 reader · [1789, 1781, 1777, …]
#@   show redis2 다른 독자 620명 · 1789 추가
#@ step "유명 계정": 팔로워가 너무 많으면 넣지 않고 읽을 때 합친다
#@   celebrity -> api "새 앨범 공개"
#@   api -> tweets "tweet 1790"
#@   show tweets [new/blue] 1790 · 새 앨범 공개
#@   light fanout : 1억 명에게 넣으면 쓰기가 몰리므로 fan-out을 건너뛴다
#@   show fanout [skip/orange] 1790 · 팔로워 1억 · 넣지 않음
#@ step "타임라인 읽기": 캐시 목록과 유명 계정 트윗을 합쳐 순위를 매긴다
#@   reader -> home "홈 열기"
#@   home -> redis1 "reader 목록" & home -> tweets "팔로우한 유명 계정"
#@   redis1 -> home "1789, 1781, 1777" & tweets -> home "1790" : 미리 넣어 둔 목록과 유명 계정 트윗을 함께 가져온다
#@   home -> ranker "후보 4개"
#@   show ranker [1/green] 1790 · 새 앨범 공개 · 0.93
#@   show ranker [2/green] 1789 · 오늘 배포 끝 · 0.88
#@   show ranker [3/gray] 1781 · 0.41
#@   ranker -> home "순위"
#@   home -> reader "타임라인 20개"
