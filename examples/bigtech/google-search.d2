# Google 검색: 질의 이해, 샤드된 색인 트리, 문서 서버, 순위와 광고 경매 (공개 논문·발표 기반 단순화)
direction: right

user: 사용자 {shape: person}

front: "프런트" {
  gfe: "GFE\n가까운 데이터센터"
  web: "웹 서버\n결과 페이지 조립"
  gfe -> web
}

query: "질의 이해" {
  spell: "철자 교정"
  intent: "의도 분류"
}

index: "색인 서빙 트리" {
  root: "루트\n결과 합치기"
  mid: "중간 집계"
  leaf1: "리프 샤드 1" {shape: cylinder}
  leaf2: "리프 샤드 2" {shape: cylinder}
  leaf3: "리프 샤드 3" {shape: cylinder}
  root -> mid
  mid -> leaf1
  mid -> leaf2
  mid -> leaf3
}

docs: "문서 서버\n제목과 요약" {shape: cylinder}
rank: "순위\n수백 개 신호"
ads: "광고 경매" {
  auction: "경매"
  budget: "예산" {shape: cylinder}
  auction -> budget
}

crawl: "색인 갱신" {
  crawler: "크롤러"
  indexer: "색인기"
  crawler -> indexer
}

user -> front.gfe
front.web -> query.spell
query.spell -> query.intent
front.web -> index.root
index.root -> rank
front.web -> docs
front.web -> ads.auction
crawl.indexer -> index.leaf1
crawl.indexer -> index.leaf2
crawl.indexer -> index.leaf3

#@ speed 2750ms
#@ step "검색": 질의는 수천 개 샤드에 퍼졌다가 합쳐진다
#@   user -> gfe "d2 diagarm" : 요청은 가장 가까운 데이터센터의 프런트로 간다
#@   gfe -> web
#@   web -> spell "d2 diagarm"
#@   show spell [fix/orange] diagarm → diagram
#@   spell -> intent
#@   show intent [type/blue] 도구 찾기 · 문서
#@   web -> root "d2 diagram" & web -> auction "d2 diagram" : 색인 검색과 광고 경매가 동시에 돈다
#@   root -> mid
#@   mid -> leaf1 & mid -> leaf2 & mid -> leaf3 : 문서는 샤드로 나뉘어 있어 모든 샤드가 동시에 찾는다
#@   show leaf1 후보 340개
#@   show leaf2 후보 512개
#@   show leaf3 후보 128개
#@   leaf1 -> mid & leaf2 -> mid & leaf3 -> mid
#@   mid -> root "상위 1000"
#@   root -> rank "상위 1000"
#@   show rank [1/green] d2lang.com · 0.97
#@   show rank [2/green] github.com/terrastruct/d2 · 0.94
#@   auction -> budget
#@   show auction [ad/purple] 광고 2개 · 낙찰
#@   web -> docs "상위 10개 요약" : 순위가 정해진 문서만 제목과 요약을 가져온다
#@   web -> gfe & gfe -> user "결과 10개 · 0.31초"
#@ step "색인 갱신": 크롤러가 바뀐 페이지를 가져와 샤드 색인을 고친다
#@   crawler -> indexer "d2lang.com/tour 변경"
#@   indexer -> leaf2 "용어 312개 갱신"
#@   show leaf2 [new/blue] d2lang.com/tour · 갱신
