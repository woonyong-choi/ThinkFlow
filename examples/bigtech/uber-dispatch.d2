# Uber 배차: 위치 수집, H3 공간 색인, 매칭과 가격, 운행 상태 (공개 발표·블로그 기반 단순화)
direction: right

rider: 승객 앱 {shape: person}
driver: 기사 앱 {shape: person}

edge: "엣지" {
  gateway: "API 게이트웨이"
  push: "푸시\n실시간 연결"
}

marketplace: "마켓플레이스" {
  supply: "Supply\n기사 위치 수집"
  demand: "Demand\n승차 요청"
  geo: "H3 공간 색인\n육각 격자"
  matching: "Dispatch\n매칭 최적화"
  eta: "ETA\n도착 시간 예측"
  pricing: "Pricing\n수요 기반 요금"
  supply -> geo: 칸 갱신
  demand -> matching
  matching -> geo: 주변 기사
  matching -> eta
  demand -> pricing
}

trips: "운행" {
  trip: "Trip\n상태 머신"
  ledger: "운행 기록" {shape: cylinder}
  trip -> ledger
}

stream: "Kafka\n이벤트 스트림" {shape: queue}
maps: "지도 데이터" {shape: cylinder; style.stroke-dash: 4}

driver -> edge.gateway: 4초마다 위치
rider -> edge.gateway: 승차 요청
edge.gateway -> marketplace.supply
edge.gateway -> marketplace.demand
marketplace.eta -> maps
marketplace.matching -> trips.trip: 배정
trips.trip -> edge.push
driver -> edge.push: 실시간 연결
rider -> edge.push: 실시간 연결
marketplace.supply -> stream
trips.trip -> stream

#@ speed 3000ms
#@ step "위치 수집": 기사 앱이 몇 초마다 위치를 보내고 육각 격자 칸이 갱신된다
#@   driver -> gateway "37.498, 127.027" : 기사 위치는 몇 초마다 들어온다
#@   gateway -> supply
#@   supply -> geo "칸 8a30… 갱신" & supply -> stream "위치 이벤트"
#@   show geo [cell/blue] 8a30e1d · 기사 7명
#@   show geo [cell/blue] 8a30e1f · 기사 3명
#@   show stream [loc/gray] driver 4182 · 8a30e1d
#@ step "매칭": 승객 요청이 오면 가까운 칸의 기사 중 도착이 가장 빠른 기사를 고른다
#@   rider -> gateway "강남역 → 판교"
#@   gateway -> demand
#@   demand -> pricing & demand -> matching : 요금 계산과 매칭을 함께 시작한다
#@   show pricing [surge/orange] 수요 1.4배 · 18,900원
#@   matching -> geo "반경 2칸" : 승객 칸과 이웃 칸에서 후보 기사를 찾는다
#@   geo -> matching "후보 10명"
#@   matching -> eta "후보 10명" : 직선 거리가 아니라 도로 기준 도착 시간으로 고른다
#@   eta -> maps "도로 그래프"
#@   eta -> matching "ETA 10개"
#@   show matching [1/green] driver 4182 · 3분 (✓)
#@   show matching [2/gray] driver 2210 · 4분
#@   show matching [3/gray] driver 7781 · 6분
#@   matching -> trip "배정" : 한 기사가 두 요청에 배정되지 않게 Trip이 상태를 잠근다
#@   show trip [state/purple] REQUESTED → ACCEPTED
#@   trip -> push & push -> driver "새 요청" & push -> rider "3분 뒤 도착" : 앱이 열어 둔 연결로 바로 밀어 준다
#@ step "운행": 운행 상태가 바뀔 때마다 기록과 이벤트로 남는다
#@   driver -> gateway "승객 탑승"
#@   gateway -> supply
#@   show trip [state/purple] ACCEPTED → ON_TRIP
#@   trip -> ledger "ON_TRIP" & trip -> stream "trip 이벤트"
#@   show ledger trip 9f21 · 강남역 → 판교 · ON_TRIP
#@   trip -> push & push -> rider "남은 시간 24분"
