# Amazon 주문: 장바구니에서 주문까지 서비스 사이 사가, 재고 예약, 결제, 출고, 실패 보상 (공개 발표 기반 단순화)
direction: right

customer: 고객 {shape: person}

web: "웹 · 앱" {
  cart: "장바구니\nDynamoDB" {shape: cylinder}
  checkout: "Checkout\n주문 확정"
  cart -> checkout
}

order: "주문" {
  workflow: "Step Functions\n주문 사가"
  orders: "주문 저장" {shape: cylinder}
  workflow -> orders
}

services: "서비스" {
  inventory: "재고\n예약"
  payment: "결제\n승인"
  fulfillment: "출고\n물류센터 배정"
}

bus: "EventBridge\n주문 이벤트" {shape: queue}
notify: "알림\n메일 · 푸시"
fc: "물류센터" {shape: cylinder; style.stroke-dash: 4}

customer -> web.cart: 담기
customer -> web.checkout: 주문하기
web.checkout -> order.workflow
order.workflow -> services.inventory
order.workflow -> services.payment
order.workflow -> services.fulfillment
services.fulfillment -> fc
order.workflow -> bus
bus -> notify
notify -> customer

#@ speed 3000ms
#@ step "주문 성공": 주문 사가가 재고, 결제, 출고를 차례로 확정한다
#@   customer -> cart "Kindle × 1"
#@   show cart Kindle · 1개 · 179,000원
#@   customer -> checkout "주문하기"
#@   cart -> checkout
#@   checkout -> workflow "order 113-42"
#@   workflow -> orders
#@   show orders [state/purple] 113-42 · PENDING
#@   workflow -> inventory "1개 예약"
#@   show inventory [hold/blue] Kindle · 1개 보류 · 15분
#@   workflow -> payment "179,000원"
#@   show payment [ok/green] 승인 (✓)
#@   workflow -> fulfillment
#@   fulfillment -> fc "ICN1 배정" : 재고가 있고 가장 빨리 보낼 수 있는 물류센터를 고른다
#@   show orders [state/purple] 113-42 · CONFIRMED
#@   workflow -> bus "OrderConfirmed"
#@   bus -> notify & notify -> customer "내일 도착" : 알림은 이벤트를 구독해 따로 보낸다
#@ step "결제 실패 보상": 결제가 거절되면 앞에서 잡은 재고 예약을 풀어 준다
#@   checkout -> workflow "order 113-43"
#@   workflow -> inventory "1개 예약"
#@   show inventory [hold/blue] Kindle · 1개 보류 · 15분
#@   workflow -> payment "179,000원"
#@   show payment [declined/orange] 카드 거절
#@   inventory -> workflow "예약 해제" : 사가는 이미 끝난 단계를 반대 동작으로 되돌린다
#@   show inventory [free/gray] Kindle · 보류 해제
#@   workflow -> orders
#@   show orders [state/purple] 113-43 · PAYMENT_FAILED
#@   workflow -> bus "PaymentFailed"
#@   bus -> notify & notify -> customer "결제 수단을 바꿔 주세요"
