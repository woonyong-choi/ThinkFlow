# Hindsight retain · recall · reflect 내부 처리 순서. 출처: arXiv 2512.12818 (TEMPR, CARA)
direction: right

agent: Your AI Agent

api: Hindsight API {
  direction: down
  retain: "retain()"
  recall: "recall()"
  reflect: "reflect()"
}

write: "Retain · TEMPR" {
  direction: down
  extract: "Fact extraction\nLLM · 2–5 narrative facts"
  resolve: "Entity resolution\nname · co-occur · time"
  linker: "Link builder\ntime · meaning · entity · cause"
  extract -> resolve -> linker
}

read: "Recall · TEMPR" {
  direction: down
  parse: "Query parse\ntime expressions"
  channels: 4 channels {
    sem: "Semantic\nHNSW"
    bm25: "Keyword\nBM25"
    graph: "Graph\nspreading activation"
    temporal: "Temporal\nrange overlap"
  }
  rrf: "RRF fusion\nk = 60"
  rerank: "Cross-encoder\nrerank"
  budget: "Token budget\ncut"
  parse -> channels.sem
  parse -> channels.bm25
  parse -> channels.graph
  parse -> channels.temporal
  channels.sem -> rrf
  channels.bm25 -> rrf
  channels.graph -> rrf
  channels.temporal -> rrf
  rrf -> rerank -> budget
}

think: "Reflect · CARA" {
  direction: down
  profile: "Bank profile\nskepticism · literalism · empathy"
  generate: "Answer + opinion\nLLM"
  reinforce: "Opinion update\nreinforce · weaken · contradict"
  profile -> generate -> reinforce
}

bank: "Memory Bank · Postgres + pgvector" {
  direction: down
  facts: "Facts\nworld · experience" {shape: cylinder}
  entities: Entities {shape: cylinder}
  links: "Links\nweighted edges" {shape: cylinder}
  obs: "Observations\nmerged beliefs" {shape: cylinder}
  opinions: "Opinions\nconfidence 0–1" {shape: cylinder}
}

worker: Background Worker {
  consolidate: "Consolidation\nfacts → observations"
}

agent -> api.retain
agent -> api.recall
agent -> api.reflect

api.retain -> write.extract
write.resolve -> bank.entities
write.linker -> bank.facts
write.linker -> bank.links
bank.facts -> worker.consolidate
worker.consolidate -> bank.obs

api.recall -> read.parse
read.channels.sem -> bank.facts
read.channels.bm25 -> bank.facts
read.channels.graph -> bank.links
read.channels.temporal -> bank.facts
api.recall <-> read.budget

api.reflect -> think.profile
api.reflect -> api.recall
think.generate -> bank.opinions
think.reinforce -> bank.opinions

#@ speed 2400ms
#@ step "retain()": 대화를 사실로 바꿔 저장한다
#@   agent -> retain "conversation" : 에이전트가 대화, 문서, 기록 같은 원문을 넘긴다.
#@   show agent [user/gray] “Alice joined Google in March.”
#@   show agent [agent/gray] “I'll suggest her for the ML project.”
#@   retain -> extract : LLM이 원문을 2~5개의 서술형 사실로 쪼갠다. 사실마다 발생 시점, 언급 시점, 종류가 붙는다.
#@   show extract [world/blue] Alice joined Google · Mar 2026
#@   show extract [experience/purple] I suggested Alice for ML
#@   extract -> resolve : 사람과 조직 이름을 이미 있는 엔티티에 묶는다. 문자열이 얼마나 비슷한지, 함께 나온 적이 있는지, 시간이 가까운지를 함께 본다.
#@   show resolve “Alice” → entity #12 · same person
#@   show resolve “Google” → entity #3
#@   resolve -> entities : 새로 나왔거나 갱신된 엔티티를 저장한다.
#@   show entities Alice #12 · Google #3 (✓)
#@   resolve -> linker : 사실끼리 네 종류의 가중치 선으로 잇는다.
#@   show linker [time/blue] exp(−Δt/σ) · nearby events
#@   show linker [meaning/purple] cosine ≥ θ
#@   show linker [entity/green] same entity · w = 1
#@   show linker [cause/orange] LLM-found cause · w = 1
#@   linker -> facts & linker -> links : 사실은 임베딩, 전문 검색 색인과 함께 저장되고 선은 그래프로 쌓인다.
#@   show facts [world/blue] Alice joined Google · Mar 2026 (new)
#@   show facts [experience/purple] I suggested Alice for ML (new)
#@   show links Alice ─entity─ Google (new)
#@   facts -> consolidate +3500ms : retain()은 여기서 끝난다. 백그라운드 워커가 새 사실을 기존 관찰과 비교한다.
#@   show consolidate [conflict/orange] Microsoft vs Google
#@   consolidate -> obs : 관찰을 새로 하나 더 만들지 않고, 있던 관찰을 고친다. 두 사실은 모두 근거로 남는다.
#@   show obs Alice works at Google · 2 sources (updated)

#@ step "recall()": 네 갈래로 찾고, 합치고, 예산만큼 자른다
#@   agent -> recall "“Where did Alice work last year?”" : 에이전트가 질문과 토큰 예산을 넘긴다.
#@   show agent [query/gray] “Where did Alice work last year?” · budget 2k tokens
#@   recall -> parse : 질문에서 시간 표현을 뽑아 기간으로 바꾼다. 규칙 기반 파서를 쓰고, 못 잡으면 작은 seq2seq 모델이 맡는다.
#@   show parse `last year → 2025-01-01 … 2025-12-31`
#@   parse -> sem & parse -> bm25 & parse -> graph & parse -> temporal : 네 채널이 동시에 돈다.
#@   sem -> facts "≈ works at" & bm25 -> facts "“Alice”" & graph -> links "Alice →" & temporal -> facts "2025" +3000ms : 의미 검색, 키워드 검색, 그래프 확산, 기간 겹침을 각자 자기 색인에서 찾는다. 그래프 채널은 엔티티 선과 원인 선을 더 크게 쳐서 퍼져 나간다.
#@   show sem #1 joined Google · #2 works at Microsoft
#@   show bm25 #1 works at Microsoft · #2 joined Google
#@   show graph #1 Microsoft · #2 Google · #3 ML project
#@   show temporal #1 works at Microsoft · Jan 2025
#@   sem -> rrf & bm25 -> rrf & graph -> rrf & temporal -> rrf : 점수가 아니라 순위만 쓴다. 각 채널 순위 r에 대해 1/(60+r)를 더하므로, 여러 채널에서 위에 오른 기억이 이긴다.
#@   show rrf [1/green] works at Microsoft · 0.065
#@   show rrf [2/green] joined Google · 0.064
#@   show rrf [3/gray] ML project · 0.016
#@   rrf -> rerank : 크로스 인코더가 질문과 기억을 한 쌍으로 읽고 다시 순위를 매긴다. 시간 정보도 입력에 넣는다.
#@   show rerank [1/green] Alice works at Microsoft · Jan 2025 (✓)
#@   show rerank [2/green] Alice joined Google · Mar 2026
#@   rerank -> budget : 위에서부터 토큰을 더하다가 예산을 넘기기 직전에 멈춘다. 상위 k개로 자르지 않는다.
#@   show budget 2 memories · 1,840 / 2,000 tokens
#@   budget -> recall & recall -> agent "ranked memories" : 에이전트는 프롬프트에 바로 넣을 수 있는 길이의 기억 목록을 받는다.
#@   show agent [1/green] Alice works at Microsoft · Jan 2025
#@   show agent [2/green] Alice joined Google · Mar 2026

#@ step "reflect()": 성향을 입혀 답하고, 의견의 확신도를 고친다
#@   agent -> reflect "“Should Alice lead ML?”" : reflect()는 기억을 근거로 판단을 요구한다.
#@   show agent [query/gray] “Should Alice lead the ML project?”
#@   reflect -> recall : 먼저 같은 recall 경로로 근거 기억을 모은다.
#@   show recall 3 memories · facts + opinions
#@   reflect -> profile : 메모리 뱅크 프로필을 읽는다. 이름, 배경, 성향 값이 시스템 프롬프트로 바뀐다.
#@   show profile `skepticism 4 · literalism 2 · empathy 3 · β 0.5`
#@   profile -> generate : LLM이 답과 함께 구조화된 의견을 낸다. 의견에는 확신도, 시점, 관련 엔티티가 붙는다.
#@   show generate [opinion/purple] Alice fits ML lead · c 0.70
#@   generate -> opinions : 새 의견을 저장한다.
#@   show opinions Alice fits ML lead · c 0.70 (new)
#@   generate -> reinforce : 나중에 새 사실이 들어오면, 엔티티가 겹치거나 뜻이 가까운 의견을 다시 평가한다.
#@   show reinforce [reinforce/green] c + α
#@   show reinforce [weaken/orange] c − α
#@   show reinforce [contradict/orange] c − 2α
#@   reinforce -> opinions : 반대 증거는 지지 증거보다 두 배로 깎는다. 의견은 지워지지 않고 확신도만 바뀐다.
#@   show opinions Alice fits ML lead · c 0.70 → 0.80 (updated)
