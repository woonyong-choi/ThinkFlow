flow right
title "실패가 쌓이면 회로를 끊는다"
subtitle "실패가 3번 쌓이면 상태가 open으로 바뀌고, 그 뒤 요청은 서비스에 닿지 못한다"

box client "클라이언트"
box breaker "차단기"
box svc "느려진 서비스"
value fails "실패 수" on=svc
value mode "상태" on=breaker from=closed
client -> breaker
breaker -> svc
svc -> breaker

step "요청이 이어진다" "서비스가 계속 실패하면 실패 수가 쌓인다" for=14s
  track client -> breaker -> svc "요청" every=2s time=1s when="mode='closed'" set="fails+1@svc"
  track svc -> breaker "임계 확인" at=1s every=2s time=600ms tone=purple when="mode='closed' && fails>=3" set="mode=open"
step "서비스가 회복된다" "복구 확인이 상태를 closed로 돌리면 요청이 다시 지나간다" for=8s keep="mode, fails"
  track client -> breaker -> svc "요청" every=2s time=1s when="mode='closed'"
  track svc -> breaker "복구 확인" at=1s time=600ms tone=green when="mode='open'" set="mode=closed, fails=0"
