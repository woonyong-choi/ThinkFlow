thinkflow
title "트래픽 급증과 지표"
subtitle "요청이 몰리면 서버 카드의 값이 바뀌고, 같은 값에 묶인 차트가 함께 움직인다"

box lb "로드 밸런서" icon=lb
box a1 "API 1" icon=server
box a2 "API 2" icon=server
box a3 "API 3" icon=server

value p95 "p95 지연(ms)" on=lb from=110
value board "대시보드 p95" on=lb ref=p95
value cpu1 "CPU(%)" on=a1 from=34
value cpu2 "CPU(%)" on=a2 from=41
value cpu3 "CPU(%)" on=a3 from=38
value peak "최고 CPU(%)" on=lb

lb -> a1
lb -> a2
lb -> a3

chart cpu "서버별 CPU" bar "예시 데이터. 막대 길이가 서버 카드의 CPU 값이다. 점선은 스케일 아웃 기준 80%" {
  x "CPU 사용률(%)"
  series load "CPU" role=main
  rule 80 "스케일 아웃"
  row "API 1" load=cpu1
  row "API 2" load=cpu2
  row "API 3" load=cpu3
}

chart lat "p95 지연 추이" line "예시 데이터. 마지막 점이 카드의 p95 값이다" {
  x "측정 순서"
  y "p95 지연(ms)"
  zero off
  series ms "p95"
  rule 250 "SLO"
  point x=1 ms=108
  point x=2 ms=112
  point x=3 ms=121
  point x=4 ms=p95
}

view graph down "서버"
view plot "CPU 사용률" {
  cpu
}
view plot "지연" {
  lat
}

scene "평상시" mode=static
  lb -> a1 time=600ms
  lb -> a2 time=600ms
  lb -> a3 time=600ms

scene "트래픽 급증"
  lb -> a1 "요청 폭주" time=700ms set="cpu1+49, p95=236"
  lb -> a2 "요청" time=700ms set="cpu2+32"
  lb -> a3 "요청" time=700ms set="cpu3+12, peak:=cpu1"

scene "서버 추가 뒤" mode=loop keep="cpu1, cpu2, cpu3, p95"
  lb -> a1 "분산" time=700ms set="cpu1-31, p95=148"
  lb -> a2 "분산" time=700ms set="cpu2-21"
  lb -> a3 "분산" time=700ms set="cpu3=44"
