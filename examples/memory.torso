torso
title "가상 페이지와 물리 프레임"
width wide
subtitle "교육용 페이징 · VPN은 페이지 표의 행 인덱스 · 같은 번호의 프레임에 놓일 필요는 없다 · 선은 상주 페이지의 대응 관계"

grid virtual "가상 메모리" rows=8 {
  item p0 "프로그램 코드" key="Page 0" row=0
  item p1 "전역 데이터" key="Page 1" row=1
  item p2 "미상주 페이지" key="Page 2" row=2
  item p3 "호출 스택" key="Page 3" row=3
  gap rest "중간 페이지 생략" row=4 rows=3 count=27
  item last "미사용" key="Page 31" row=7
}
grid mapping "페이지 표" rows=5 cols=3 {
  item hv "VPN" row=0 col=0
  item hs "상주" row=0 col=1
  item hf "PFN" row=0 col=2
  item v0 "0" row=1 col=0
  item s0 "1" row=1 col=1
  item f0 "3" row=1 col=2
  item v1 "1" row=2 col=0
  item s1 "1" row=2 col=1
  item f1 "0" row=2 col=2
  item v2 "2" row=3 col=0
  item s2 "0" row=3 col=1
  item f2 "—" row=3 col=2
  item v3 "3" row=4 col=0
  item s3 "1" row=4 col=1
  item f3 "2" row=4 col=2
}
grid physical "물리 메모리" rows=8 {
  item f0 "Page 1 · 전역 데이터" key="Frame 0" row=0
  item f1 "빈 프레임" key="Frame 1" row=1
  item f2 "Page 3 · 호출 스택" key="Frame 2" row=2
  item f3 "Page 0 · 프로그램 코드" key="Frame 3" row=3
  gap rest "중간 프레임 생략" row=4 rows=3 count=11
  item last "빈 프레임" key="Frame 15" row=7
}
virtual.p0 -> mapping.v0
mapping.f0 -> physical.f3
virtual.p1 -> mapping.v1
mapping.f1 -> physical.f0
virtual.p3 -> mapping.v3
mapping.f3 -> physical.f2
view graph right
scene "페이지 배치" mode=static
scene "Page 1 접근" mode=once
  light virtual.p1
  virtual.p1 -> mapping.v1 "VPN 1"
  light mapping.v1 mapping.s1 mapping.f1
  mapping.f1 -> physical.f0 "PFN 0"
  light physical.f0
scene "Page 0 접근" mode=once
  light virtual.p0
  virtual.p0 -> mapping.v0 "VPN 0"
  light mapping.v0 mapping.s0 mapping.f0
  mapping.f0 -> physical.f3 "PFN 3"
  light physical.f3
