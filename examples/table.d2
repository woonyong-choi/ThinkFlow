# 표, 격자 같은 D2 기능도 D2가 그대로 그린다.
direction: right
sessions: {
  shape: sql_table
  id: int {constraint: primary_key}
  agent: text
}
messages: {
  shape: sql_table
  id: int {constraint: primary_key}
  session_id: int {constraint: foreign_key}
  body: text
}
engine: 엔진
messages.session_id -> sessions.id
engine -> messages: INSERT

#@ step "기록"
#@   engine -> messages "INSERT"
#@   messages.session_id -> sessions.id : 세션을 가리킨다
