flow right
title "같은 시각에 요청해도 잠금은 하나만 쥔다"
subtitle "조건 확인과 잠금 쥐기를 한 사건으로 처리해, 세 요청 가운데 하나만 들어가고 나머지는 차례를 기다린다"

box a "작업 A"
box b "작업 B"
box c "작업 C"
box lock "잠금"
value holder "쥔 쪽" on=lock from=none
a -> lock
b -> lock
c -> lock

step "세 작업이 같은 시각에 요청한다" "A가 풀면 먼저 기다린 B가 쥐고, B가 풀면 C가 쥔다" for=14s
  track a -> lock "요청" at=0s time=900ms wait="holder='none'" reserve="holder=A"
  track b -> lock "요청" at=0s time=900ms wait="holder='none'" reserve="holder=B"
  track c -> lock "요청" at=0s time=900ms wait="holder='none'" reserve="holder=C"
  track a -> lock "풀기" at=4s time=900ms tone=purple when="holder='A'" set="holder=none"
  track b -> lock "풀기" at=9s time=900ms tone=purple when="holder='B'" set="holder=none"
