flow right
title "서비스 상태 구성도"
subtitle "상태를 색으로 나눈다. 초록은 정상, 호박은 지연, 빨강은 오류, 회색은 중지이고 오류가 난 결제는 테두리도 빨강이다"

width wide

person user "사용자"
box gateway "게이트웨이" "라우팅" fill=green stroke=green
box orders "주문" "주문 접수" fill=green stroke=green
box payments "결제" "승인 오류 중" fill=red stroke=red
box search "검색" "응답 지연" fill=amber stroke=amber
store ledger "원장" "데이터베이스" fill=green stroke=green
store cache "캐시" "중지" fill=gray stroke=gray

user -> gateway "요청" no=1
gateway -> orders "주문" no=2
gateway -> search "검색" no=3
orders -> payments "결제 요청" no=4
payments -> ledger "기록" no=5
search -> cache "조회"

step "접수" "게이트웨이가 요청을 받아 주문과 검색으로 나눈다"
  user -> gateway
  gateway -> orders & gateway -> search
step "결제" "결제가 승인 오류를 내서 기록까지 가지 못한다"
  orders -> payments
  light payments
  show payments "승인 실패" tag="err" tone=gray card=red
step "복구" "원장에는 접수 기록만 남는다"
  show ledger "접수만 기록" card=amber
  light ledger
