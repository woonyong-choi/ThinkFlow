thinkflow
title "TL-UL 요청과 응답 핸드셰이크"
subtitle "valid와 ready가 함께 1인 순간에 한 번 전달된다 · A 채널은 요청, D 채널은 응답"
pace 500ms

box host "호스트"
box dev "장치"

value avalid "a_valid" from=0
value aready "a_ready" from=0
value aop "A 채널" from=idle
value dvalid "d_valid" from=0
value dready "d_ready" from=1
value dop "D 채널" from=idle

view sequence "메시지" {
  host dev
}
view timing "신호" {
  avalid aready aop
  dvalid dready dop
  note aop=Get "요청 전달"
}

scene "Get 한 번"
  host -> dev "Get 0x40" set="avalid=1@host, aop=Get@host, aready=1"
  wait 300ms
  dev -> host "AccessAckData" set="avalid=0@dev, aready=0@dev, aop=idle@dev, dvalid=1@dev, dop=0x2A@dev, dvalid=0, dop=idle"
  wait 300ms
