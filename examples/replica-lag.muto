flow right
title "복제 지연"
subtitle "주 DB가 바뀐 뒤 복제본이 늦게 따라오는 동안 복제본을 읽으면 옛 값이다"

box writer "쓰는 앱"
box reader "읽는 앱"
store primary "주 DB"
store replica "복제본"
value pv "주 DB 값" on=primary from=1
value rv "복제본 값" on=replica from=1
value seen "읽은 값" on=reader
writer -> primary
primary -> replica
reader -> replica

step "복제가 늦는다" "복제 도중에 읽으면 옛 값을 읽는다" for=10s
  track writer -> primary "2 쓰기" at=0s time=1s set="pv=2"
  track primary -> replica "복제" at=1s time=6s set="rv=2"
  track reader -> replica "읽기" at=3s time=1s set="seen=1"
