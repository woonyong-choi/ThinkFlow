daphnis 2
title "서비스별 오류 유형 비율"
subtitle "행마다 전체 오류를 100%로 놓고 유형이 차지하는 몫을 본다"

chart kinds "오류 유형 구성" percent "예시 데이터. 최근 7일 오류 건수. 건수가 없거나 합계가 0인 행은 비율을 정하지 않는다" {
  x "오류 구성(%)"
  series timeout "타임아웃"
  series refused "연결 거부"
  series auth "인증 실패"
  series bad "잘못된 요청"
  series notfound "없는 리소스"
  series conflict "중복 요청"
  series limit "호출 한도"
  series fault "서버 예외"
  series dep "외부 의존성"
  missing "집계 없음"
  row "주문 API" timeout=30 refused=4 auth=9 bad=12 notfound=3 conflict=7 limit=2 fault=11 dep=6
  row "결제 API" timeout=14 refused=2 auth=22 bad=5 notfound=1 conflict=18 limit=0 fault=4 dep=31
  row "검색 API" timeout=8 refused=1 auth=2 bad=41 notfound=19 conflict=0 limit=24 fault=3 dep=2
  row "알림 API" timeout=- refused=- auth=- bad=- notfound=- conflict=- limit=- fault=- dep=-
  row "정산 배치" timeout=0 refused=0 auth=0 bad=0 notfound=0 conflict=0 limit=0 fault=0 dep=0
}

scene "전체 구성"

scene "유형 하나씩"
  reveal kinds.timeout kinds.refused
  wait 1s
  reveal kinds.auth kinds.bad kinds.notfound
  wait 1s
  reveal kinds.conflict kinds.limit kinds.fault kinds.dep

scene "결제 API"
  light kinds "결제 API"
