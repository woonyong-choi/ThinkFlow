flow right
title "갱신 손실"
subtitle "두 요청이 같은 재고를 읽고 각자 쓰면 한 건이 사라진다"

box a "주문 A"
box b "주문 B"
store db "재고 DB"
value stock "재고" on=db from=10
value ra "A가 읽음" on=a
value rb "B가 읽음" on=b
a -> db
b -> db

step "읽고 쓰기" "둘 다 10을 읽고 각자 9를 쓴다"
  db -> a "읽기" set="ra=10" & db -> b "읽기" set="rb=10"
  say "두 주문이 같은 재고 10을 읽었다"
  a -> db "9 쓰기" set="stock=9"
  b -> db "9 쓰기" set="stock=9"
  say "재고는 8이어야 하는데 9다. 한 건이 사라졌다"
