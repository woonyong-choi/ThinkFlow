flow right
title "함수를 호출하면 스택에 쌓이는 것"

box caller "호출하는 코드" "foo(n)"
grid stack "스택 (위가 낮은 주소)" rows=5 cols=1 {
  item local "지역 변수 buf" row=0
  item saved "저장된 rbp" row=1
  item ret "반환 주소" row=2
  item arg "인자 n" row=3
  gap older "이전 프레임" row=4 count=12
}
caller -> stack "call foo"

step "호출" "호출하는 쪽이 인자를 넣고 반환 주소를 쌓는다"
  caller -> stack "인자와 반환 주소"
  light stack.arg
  light stack.ret
step "프롤로그" "foo가 rbp를 저장하고 지역 변수 자리를 만든다"
  light stack.saved
  light stack.local
