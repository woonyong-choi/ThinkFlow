thinkflow
title "함수 호출과 스택 프레임"
subtitle "foo(n)을 호출하면 인자, 반환 주소, 저장된 rbp, 지역 변수가 차례로 쌓인다"

box code "main()" "foo(7) 호출"
grid foo "foo 프레임 (위가 낮은 주소)" rows=4 {
  item local "지역 변수 buf[8]" row=0
  item saved "저장된 rbp" row=1
  item ret "반환 주소" row=2
  item arg "인자 n = 7" row=3
}
grid caller "main 프레임" rows=3 {
  item mlocal "지역 변수 total" row=0
  item msaved "저장된 rbp" row=1
  gap older "이전 프레임" row=2 count=12
}

value depth "호출 깊이" on=code from=1

code -> foo.arg "인자 n" no=1
foo.ret -> code "return" no=2
foo.saved -> caller.msaved "rbp 복원" no=3

view graph down

scene "프레임 구조" mode=static
  light foo caller

scene "호출"
  code -> foo.arg time=700ms set="depth+1"
  light foo.arg
  light foo.ret
  light foo.saved
  light foo.local

scene "반환" keep="depth"
  light foo.local
  foo.saved -> caller.msaved time=700ms
  foo.ret -> code time=700ms set="depth-1"

scene "재귀 호출" mode=loop for=6s
  track code -> foo.arg at=0s every=1500ms time=900ms set="depth+1"
