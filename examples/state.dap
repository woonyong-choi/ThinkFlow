daphnis 2
title "주문 상태 전이"
subtitle "결제, 출고, 취소와 반품이 어떤 사건으로 이어지는지 상태로 정리한다"

state created "생성됨"
state paid "결제 완료"
group fulfil "출고 이후" direction=down {
  state shipped "배송 중"
  state delivered "배송 완료"
}
state cancelled "취소됨"
state returned "반품됨"
start created
final delivered
final cancelled
final returned

created -> created "결제 재시도"
created -> paid "결제 승인"
created -> cancelled "결제 실패"
paid -> shipped "출고"
paid -> cancelled "고객 취소" dashed
shipped -> delivered "수령 확인"
delivered -> returned "7일 안 반품" dashed

view graph down

scene "상태 전체"

scene "정상 주문"
  created -> paid "승인" time=700ms
  paid -> shipped time=700ms
  shipped -> delivered "수령" time=700ms

scene "결제 재시도와 취소"
  created -> created "재시도" time=700ms
  created -> cancelled "실패" time=700ms

scene "출고 전 취소" mode=loop
  created -> paid time=600ms
  paid -> cancelled time=700ms

scene "배송 뒤 반품"
  shipped -> delivered time=700ms
  delivered -> returned time=800ms
  light fulfil
