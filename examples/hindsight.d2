# Hindsight "What Hindsight Does" 그림을 D2 문법으로 옮겨 본 것. 원본: vectorize-io/hindsight hindsight-interfig
direction: right

agent: Your AI Agent

api: Hindsight API {
  direction: down
  retain: "Retain\nLLM extraction"
  recall: Recall {
    direction: down
    semantic: "Semantic\nby meaning"
    keyword: "Keyword\nexact words"
    graph: "Graph\nvia entities"
    temporal: "Temporal\nby time"
  }
}

bank: Memory Bank {
  direction: down
  sources: Sources {
    docs: Documents {shape: cylinder}
    chunks: Chunks {shape: cylinder}
    docs -> chunks
  }
  memories: Memories {
    indexes: Indexes {
      direction: down
      vectors: Vectors {shape: cylinder}
      fulltext: Full text {shape: cylinder}
      egraph: Entity graph {shape: cylinder}
      time: Dates {shape: cylinder}
    }
    facts: "Facts\nworld · experience" {shape: cylinder}
    obs: "Observations\nconsolidated beliefs" {shape: cylinder}
    indexes -> facts
    indexes -> obs
  }
  sources.chunks -> memories.facts: extract
}

worker: Hindsight Worker {
  direction: down
  consolidate: "Consolidation\nfacts → observations"
  refresh: "Refresh\nobservations → pages"
  consolidate -> refresh: when done
}

agent -> api.retain: retain()
agent -> api.recall: recall()
api.retain -> bank.sources.docs
api.recall.semantic -> bank.memories.indexes.vectors
api.recall.keyword -> bank.memories.indexes.fulltext
api.recall.graph -> bank.memories.indexes.egraph
api.recall.temporal -> bank.memories.indexes.time
bank.memories.facts -> worker.consolidate: new facts
worker.consolidate -> bank.memories.obs

#@ speed 5500ms
#@ step "retain()"
#@   agent -> retain "the conversation" : Your agent sends what happened: a conversation, a document, a transcript.
#@   show agent [user/gray] “Alice joined Google in March, she loves the research team.”
#@   show agent [agent/gray] “Noted, I’ll suggest her for the ML project.”
#@   retain -> docs : The original text is stored as a document.
#@   show docs [chat/gray] Sep 22 · 2 messages
#@   docs -> chunks : It is split into chunks, so the exact passage can be handed back later.
#@   show chunks [#1/gray] “Alice joined Google in March, she loves…”
#@   chunks -> facts +8000ms : An LLM pulls out facts: world facts about others, and experience facts about what the agent itself did.
#@   show facts [world/blue] Alice works at Microsoft · Jan 2025
#@   show facts [world/blue] Alice joined Google · Mar 2026 (new)
#@   show facts [experience/purple] I suggested Alice for the ML project (new)
#@   wait 3200 : Each fact is indexed four ways: by meaning, by its words, by the entities it links, and by when it happened.
#@   show vectors 2 embeddings
#@   show fulltext `alice · google · research`
#@   show egraph graph Alice -> Google, Alice -> ML project ; Alice
#@   show time Mar 2026 · Sep 2026
#@   retain -> agent "✓ stored" +4500ms : retain() is done. The rest happens in the background.
#@   show agent [user/gray] “Alice joined Google in March, she loves the research team.”
#@   show agent [agent/gray] “Noted, I’ll suggest her for the ML project.”
#@   show agent [result/green] stored (✓)
#@   facts -> consolidate +7500ms : Consolidation checks the new facts against the observations the bank already holds.
#@   show consolidate 2 new facts
#@   show consolidate [conflict/orange] Microsoft vs Google
#@   show obs Alice works at Microsoft · 1 source (conflict)
#@   consolidate -> obs +9500ms : It updates that observation instead of adding a second one. Both facts stay as its sources.
#@   show obs Alice works at Google, on the research team · 2 sources (updated)
#@   show obs [resolved/orange] Microsoft (Jan 2025) → Google (Mar 2026)
#@ step "recall()"
#@   agent -> recall "“Where does Alice work?”" : recall() finds the memories that matter for a query.
#@   show agent [query/gray] “Where does Alice work?”
#@   semantic -> vectors "≈ works at" & keyword -> fulltext "“Alice”" & graph -> egraph "Alice → Google" +8500ms : Searches run at once, each through its own index.
#@   show vectors “joined Google” · 0.82 (✓)
#@   show fulltext “alice” · “work” · 4 hits (✓)
#@   show egraph graph Alice -> Google, Alice -> ML project ; Alice, Google
#@   show time no date in query · skipped
#@   indexes -> facts "facts" & indexes -> obs "observations" +8000ms : The same indexes cover facts and observations, so both come back.
#@   show facts [world/blue] Alice joined Google · Mar 2026 (✓)
#@   show facts [experience/purple] I suggested Alice for the ML project (✓)
#@   show obs Alice works at Google, on the research team · 2 sources (✓)
#@   recall -> agent "3 memories, ranked" +8000ms : The agent gets ranked memories it can put straight into its prompt.
#@   show agent [query/gray] “Where does Alice work?”
#@   show agent [1/green] Alice works at Google, research team
#@   show agent [2/green] Alice joined Google · Mar 2026
#@   show agent [3/green] I suggested Alice for ML
