flow right
title "유실되는 요청"
subtitle "첫 단계는 구간마다 시간을 정해 요청이 로드 밸런서를 빨리 지나고, 둘째 단계는 요청이 API 앞에서 사라져 받은 수가 늘지 않는다. 단계마다 도형 상태가 붙었다 떨어진다"

box client "클라이언트"
box lb "로드 밸런서"
box api "API" "주문 접수"
store db "DB" "주문 저장"
value hits "받은 요청" on=api from=0

client -> lb
lb -> api
api -> db

step "정상" "요청이 구간마다 정한 시간으로 DB까지 간다" for=8s status="api=ok"
  track client -> lb -> api -> db "요청" every=2s time=4s legs="500ms, 1s, -" set="hits+1@api"
step "유실" "요청이 API에 닿기 전에 사라지고 받은 요청이 늘지 않는다" for=8s status="lb=warn, api=wait"
  track client -> lb -> api -> db "요청" every=2s time=4s lost=50% set="hits+1@api"
step "복구" for=4s
  track client -> lb -> api -> db "요청" every=2s time=3s
