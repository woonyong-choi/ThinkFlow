flow right
title "잠금으로 막기"
subtitle "잠금을 쥔 작업이 끝나야 기다리던 작업이 들어간다"

box a "작업 A"
box b "작업 B"
box lock "잠금"
store db "재고 DB"
value holder "쥔 쪽" on=lock from=none
a -> lock
b -> lock
a -> db
b -> db

step "A가 잠금을 쥔다" "B는 잠금이 풀릴 때까지 기다린다"
  a -> lock "잠금 요청" set="holder=A"
  b -> lock "잠금 요청"
  show b "대기 중" tag="wait"
  a -> db "쓰기"
  say "A가 쓰는 동안 B는 들어가지 못한다"
step "풀리면 B가 들어간다"
  a -> lock "풀기" set="holder=none"
  b -> lock "다시 요청" set="holder=B"
  b -> db "쓰기"
