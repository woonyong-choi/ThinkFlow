daphnis 2
title "주문 스키마"
subtitle "키, NULL 허용 여부, 삭제 정책을 열마다 적은 관계형 스키마"

table users "users" {
  id bigint pk
  email text unique required
  referrer_id bigint fk=users.id nullable ondelete=set-null
  deleted_at timestamp nullable
}
table coupons "coupons" {
  id bigint pk
  code text unique required
}
table orders "orders" {
  id bigint pk
  user_id bigint fk=users.id required ondelete=restrict
  coupon_id bigint fk=coupons.id nullable ondelete=set-null
  status text required
}
table products "products" {
  id bigint pk
  sku text unique required
  price "numeric(10, 2)" required
  stock int required
}
table order_items "order_items" {
  id bigint pk
  order_id bigint fk=orders.id required ondelete=cascade
  product_id bigint fk=products.id required ondelete=no-action
  qty int required
}

view graph down

scene "스키마 전체"

scene "외래 키 따라가기"
  order_items -> orders time=900ms
  show orders "id 7 · 결제 완료" tag="행" tone=blue
  orders -> users time=900ms
  show users "id 3 · kim@example.com" tag="행" tone=blue

scene "삭제 정책"
  light orders.user_id orders.coupon_id order_items.order_id
  wait 1s
  light order_items.product_id products.id

scene "키와 제약" mode=loop
  light users.id users.email
  wait 1s
  light products.sku products.price
  wait 1s
  light order_items.qty
