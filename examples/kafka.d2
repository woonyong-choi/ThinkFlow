# 이벤트 스트림: 큐 도형, 동시에 여러 점, 소비자 그룹, 실패 격리
direction: right
producers: 생산자 {
  direction: down
  web: 웹 서버
  mobile: 모바일 API
}
topic: "topic: orders" {
  direction: down
  p0: 파티션 0 {shape: queue}
  p1: 파티션 1 {shape: queue}
  p2: 파티션 2 {shape: queue}
}
group: "소비자 그룹: billing" {
  direction: down
  c0: 소비자 A
  c1: 소비자 B
}
db: 결제 DB {shape: cylinder}
dlq: DLQ {shape: queue; style.stroke-dash: 4}

producers.web -> topic.p0
producers.web -> topic.p1
producers.mobile -> topic.p2
topic.p0 -> group.c0
topic.p1 -> group.c0
topic.p2 -> group.c1
group.c0 -> db
group.c1 -> db
group.c1 -> dlq: 3회 실패

#@ step "발행": 키의 해시로 파티션이 정해진다
#@   web -> p0 "order-17" & web -> p1 "order-42" & mobile -> p2 "order-8"
#@   show p0 offset 1041 · order-17
#@   show p1 offset 988 · order-42
#@   show p2 offset 1203 · order-8
#@ step "소비": 한 파티션은 그룹 안 한 소비자만 읽는다
#@   p0 -> c0 & p1 -> c0 & p2 -> c1 : 소비자 A는 파티션 두 개를, B는 하나를 맡는다
#@   show c0 order-17 · order-42
#@   show c1 order-8
#@   c0 -> db "청구 2건" & c1 -> db "청구 1건"
#@   show db [ok/green] 3건 기록 (✓)
#@ step "실패": 세 번 실패하면 DLQ로 뺀다
#@   p2 -> c1 "order-9"
#@   show c1 [retry/orange] order-9 · 카드 거절 · 3/3
#@   c1 -> dlq "order-9" : 막힌 메시지 때문에 파티션 전체가 멈추지 않게 한다
#@   show dlq order-9 · card_declined
