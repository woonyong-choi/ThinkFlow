flow right
title "주문 이벤트 스트림"
subtitle "생산자 셋이 카프카 토픽 orders의 파티션 셋으로 쓰고, 소비자 둘이 파티션을 나눠 읽는다. 평상시, 소비자 지연, 실패의 DLQ 이동을 흐름으로 본다"
width wide

group producers "생산자" icon=server {
  box orderapi "주문 API" "주문 생성" icon=server
  box payapi "결제 API" "결제 승인" icon=server
  box stockapi "재고 API" "재고 차감" icon=server
}
group cluster "카프카 클러스터" icon=kafka {
  group topic "토픽 orders" {
    box p0 "파티션 0" "해시 0" icon=kafka
    box p1 "파티션 1" "해시 1" icon=kafka
    box p2 "파티션 2" "해시 2" icon=kafka
  }
  box retry "재시도" "retry 토픽" icon=kafka
  store dlq "DLQ" "orders.dlq" fill=red
}
group consumers "소비자 그룹" icon=scaling {
  box settle "정산 소비자" "파티션 0·1" icon=function count=2
  box notify "알림 소비자" "파티션 1·2" icon=function
}
store db "정산 DB" "주문 정산" icon=db

value off0 "offset" on=p0
value off1 "offset" on=p1
value off2 "offset" on=p2
value lagset "lag" on=settle
value lagnot "lag" on=notify
value done "처리 건수" on=settle
value rows "정산 행" on=db
value dead "DLQ 건수" on=dlq
on p0 off0+1, lagset+1
on p1 off1+1, lagset+1, lagnot+1
on p2 off2+1, lagnot+1
on settle lagset-1, done+1
on notify lagnot-1
on db rows+1
on dlq dead+1

orderapi -> p0 "주문" no=1
orderapi -> p1 "주문" no=2
payapi -> p1 "결제" no=3
stockapi -> p2 "재고" no=4
p0 -> settle no=5
p1 -> settle no=6
p1 -> notify no=7
p2 -> notify no=8
settle -> db "정산 기록" no=9
settle -> retry "실패" dashed no=10
retry -> dlq "한도 초과" dashed no=11

step "이벤트 하나" "주문 이벤트 하나가 파티션에서 소비자를 거쳐 정산 DB까지 간다"
  orderapi -> p0 "OrderCreated"
  say "키 해시로 파티션 0에 쌓이고 offset이 하나 오른다"
  p0 -> settle "offset 읽기"
  say "정산 소비자가 파티션 0을 읽는다. 읽은 만큼 lag가 줄어든다"
  settle -> db "정산 행"
step "평상시 트래픽" "생산자 셋이 끊이지 않고 쓰고, 소비자가 따라 읽는다" for=5s
  track orderapi -> p0 time=1.2s every=0.9s
  track p0 -> settle time=1.2s every=0.9s at=1.3s
  track settle -> db time=1.2s every=0.9s at=2.6s
  track payapi -> p1 time=1.2s every=1.1s at=0.2s
  track p1 -> notify time=1.2s every=1.1s at=1.4s
  track stockapi -> p2 time=1.2s every=0.8s at=0.1s
  track p2 -> notify time=1.2s every=0.8s at=1.4s
step "소비자 지연" "알림 소비자가 느려져 파티션 2의 lag가 쌓인다" for=5s
  track stockapi -> p2 time=1.2s every=0.5s
  track orderapi -> p0 time=1.2s every=1s at=0.2s
  track p2 -> notify time=1.2s every=2s
  track p0 -> settle time=1.2s every=1s at=0.5s
step "실패가 DLQ로" "정산이 실패하면 재시도 토픽을 거쳐 DLQ에 쌓인다" for=5s
  track orderapi -> p0 time=1.2s every=1.1s
  track p0 -> settle time=1.2s every=1.1s at=1.3s
  track settle -> retry "처리 실패" time=1.2s every=1.6s at=0.6s tone=red
  track retry -> dlq time=1.2s every=1.6s at=1.9s tone=red
