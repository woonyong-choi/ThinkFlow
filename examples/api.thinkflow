thinkflow
title "주문 API 계약"
subtitle "앱이 보내는 요청 칸이 내부 API와 결제 API, 테이블 열로 어떻게 이어지는지 본다"

person app "모바일 앱"
api create "POST /orders" {
  auth "Authorization"
  body "OrderRequest"
  created "201 OrderResponse"
  invalid "422 ProblemDetail"
}
api read "GET /orders/{id}" {
  path "id: UUID"
  found "200 OrderResponse"
  missing "404 ProblemDetail"
}
api charge "POST https://pay.example.com/v1/charges" {
  amount "amount: int"
  token "payment_token"
  approved "200 Charge"
}
table orders "orders" {
  id uuid pk
  total_amount int required
  status text required
}

app -> create.body "주문 요청"
app -> read.path "조회 요청"
create.body -> charge.amount "금액 전달"
charge.approved -> orders.status "결제 결과"
create.body -> orders.total_amount "합계 저장"
read.found -> orders.id "행 읽기"

view graph down

scene "계약 전체"

scene "주문 생성"
  app -> create.body time=700ms
  create.body -> charge.amount time=700ms
  charge.approved -> orders.status time=700ms
  light create.created

scene "주문 조회"
  app -> read.path time=700ms
  read.found -> orders.id time=700ms
  light read.found read.missing

scene "응답 칸" mode=loop
  light create.created
  wait 800ms
  light create.invalid
  wait 800ms
  light read.missing
