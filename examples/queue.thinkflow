thinkflow
title "큐 적체와 역압"
subtitle "생산이 소비보다 빠르면 큐가 차고, 가득 차면 생산자는 기다리다 보관함으로 돌린다"

box prod "주문 접수" icon=apigw
queue jobs "결제 큐" slots=8 from=3
box worker "결제 워커" icon=function
box dlq "재시도 보관함" icon=db
box admin "운영자" icon=monitoring

value len "큐 길이" on=prod ref=jobs
value done "처리 완료" on=worker
value held "보관된 주문" on=dlq

on worker done+1
on dlq held+1

prod -> jobs
jobs -> worker
prod -> dlq quiet
worker -> admin dashed

view graph down

scene "큐 구조"

scene "가득 찬 큐" set="jobs=8"
  prod -> jobs "주문 접수" time=700ms when="jobs<8" reserve="jobs+1"
  prod -> dlq "자리 없음" time=700ms
  jobs -> worker "처리" time=700ms when="jobs>0" reserve="jobs-1"
  prod -> jobs "다시 접수" time=700ms when="jobs<8" reserve="jobs+1"

scene "생산이 더 빠를 때" mode=loop for=8s
  track prod -> jobs at=0s every=1s time=700ms wait="jobs<8" timeout=1500ms else=dlq reserve="jobs+1" tone=blue
  track jobs -> worker at=500ms every=2s time=700ms wait="jobs>0" reserve="jobs-1" tone=green

scene "처리 결과 전달" keep="done"
  jobs -> worker "처리" time=700ms set="jobs-1"
  worker -> admin "완료 알림" time=700ms lost=50%

scene "워커가 멈춘 큐" for=6s status="worker=wait, dlq=warn"
  track jobs -> worker at=0s time=2s wait="done>100" stuck
  track prod -> jobs at=500ms time=1500ms wait="jobs<8" timeout=3s else=dlq reserve="jobs+1"
