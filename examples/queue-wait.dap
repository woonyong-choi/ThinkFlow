flow right
title "큐가 차면 생산이 기다린다"
subtitle "가득 차기 전에 멈추고, 빈 칸이 생기면 그 시각에 넣고, 오래 기다리면 포기한다"

box prod "생산자"
queue q "큐" slots=4
box cons "소비자"
store dlq "버린 작업"
value dropped "버린 수" on=dlq
on q q+1
on dlq dropped+1
prod -> q
q -> cons
prod -> dlq

step "생산이 소비보다 빠르다" "1초마다 넣고 3초마다 꺼낸다. 큐가 3칸에 닿으면 생산이 기다린다" for=16s
  track prod -> q "작업" every=1s time=600ms wait="q<3" timeout=900ms else=dlq
  track q -> cons "꺼냄" at=3s every=3s time=600ms tone=purple set="q-1@q"
step "소비가 빨라진다" "1초마다 꺼내면 큐에 빈 칸이 계속 있어, 생산이 기다리지 않는다" for=8s keep="q, dropped"
  track prod -> q "작업" every=1s time=600ms wait="q<3" timeout=900ms else=dlq
  track q -> cons "꺼냄" at=500ms every=1s time=600ms tone=purple set="q-1@q"
