torso
title "주문 요청과 재고 잠금"
subtitle "잠금을 쥔 동안 DB에 쓰고, DB가 느리면 API가 먼저 시간 초과로 응답한다"
pace 500ms

person client "클라이언트"
box api "주문 API"
box lock "재고 잠금"
store db "주문 DB"

value req "요청" from=idle
value holder "잠금 보유" from=none
value write "DB 쓰기" from=0

view sequence "호출 순서" {
  client api db lock
}
view timing "시간에 따른 상태" {
  client api db lock
  req holder write
  note holder=order-1 "잠금 유지"
}

scene "정상 처리"
  client -> api "POST /orders" set="req=처리중"
  api -> lock "잠금" set="holder=order-1"
  api -> db "INSERT" set="write=1"
  db -> api "OK" dashed set="write=0"
  api -> lock "해제" set="holder=none"
  api -> client "201 Created" dashed set="req=완료"

scene "DB 지연과 시간 초과" status="db=warn"
  client -> api "POST /orders" set="req=처리중"
  api -> lock "잠금" set="holder=order-1"
  api -> db "INSERT" time=3s set="write=1"
  api -> client "504 시간 초과" dashed set="req=시간초과"
  db -> api "OK" dashed set="write=0"
  api -> lock "해제" set="holder=none"
