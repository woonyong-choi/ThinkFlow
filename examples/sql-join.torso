torso
title "SQL INNER JOIN · 입력 행에서 결과 행까지"
width wide
subtitle "SELECT o.id, u.name FROM orders o JOIN users u ON o.user_id = u.id · 키가 같은 행을 결합하는 논리적 설명 · 특정 DB 실행계획 아님 · 빈 결과 칸(—)에 대응 행을 순서대로 생성"

grid orders "orders" rows=4 cols=2 {
  item hi "id" row=0 col=0
  item hu "user_id" row=0 col=1
  item i10 "10" row=1 col=0
  item u10 "1" row=1 col=1
  item i11 "11" row=2 col=0
  item u11 "2" row=2 col=1
  item i12 "12" row=3 col=0
  item u12 "1" row=3 col=1
}
grid users "users" rows=4 cols=2 {
  item hi "id" row=0 col=0
  item hn "name" row=0 col=1
  item i1 "1" row=1 col=0
  item n1 "민수" row=1 col=1
  item i2 "2" row=2 col=0
  item n2 "지수" row=2 col=1
  item i3 "3" row=3 col=0
  item n3 "수진" row=3 col=1
}
grid result "결합 결과" rows=4 cols=2 {
  item hi "o.id" row=0 col=0
  item hn "u.name" row=0 col=1
  item i10 "10" row=1 col=0
  item n10 "민수" row=1 col=1
  item i11 "11" row=2 col=0
  item n11 "지수" row=2 col=1
  item i12 "12" row=3 col=0
  item n12 "민수" row=3 col=1
}
value id10 "주문 번호" on=result.i10 from=—
value name10 "사용자 이름" on=result.n10 from=—
value id11 "주문 번호" on=result.i11 from=—
value name11 "사용자 이름" on=result.n11 from=—
value id12 "주문 번호" on=result.i12 from=—
value name12 "사용자 이름" on=result.n12 from=—
orders.u10 -> users.i1
orders.u11 -> users.i2
orders.u12 -> users.i1
users.n1 -> result.i10
users.n2 -> result.i11
users.n1 -> result.i12
view graph right
scene "키와 결과 구조" mode=static set="id10=10, name10=민수, id11=11, name11=지수, id12=12, name12=민수"
scene "행 결합 과정" mode=once
  light orders.i10 orders.u10
  orders.u10 -> users.i1 "1 = 1"
  light users.i1 users.n1
  users.n1 -> result.i10 "10 · 민수" set="id10=10, name10=민수"
  light result.i10 result.n10
  light orders.i11 orders.u11
  orders.u11 -> users.i2 "2 = 2"
  light users.i2 users.n2
  users.n2 -> result.i11 "11 · 지수" set="id11=11, name11=지수"
  light result.i11 result.n11
  light orders.i12 orders.u12
  orders.u12 -> users.i1 "1 = 1"
  light users.i1 users.n1
  users.n1 -> result.i12 "12 · 민수" set="id12=12, name12=민수"
  light result.i12 result.n12
scene "같은 사용자의 주문 두 건" mode=static set="id10=10, name10=민수, id11=11, name11=지수, id12=12, name12=민수"
  light orders.i10 orders.u10 orders.i12 orders.u12 users.i1 users.n1 result.i10 result.n10 result.i12 result.n12
