thinkflow
title "클라우드 구성"
subtitle "웹 요청은 DNS, CDN, 로드 밸런서, 웹 서버를 지나 앱 서버에 닿고(1~6), 운영자는 VPN과 배스천으로 들어온다(7~9)"

person user "웹 사용자"
person admin "운영자" icon=admin
group net "인터넷" icon=cdn border=dashed direction=right {
  box dns "DNS" shape=tile icon=dns
  box cdn "CDN" shape=tile icon=cdn
}
group cloud "클라우드" icon=region direction=down border=dashed {
  box lb "로드 밸런서" shape=tile icon=lb
  box web "웹 서버" shape=tile icon=server count=3
  box app "앱 서버" shape=tile icon=server
  group data "데이터" direction=right {
    store db "DB 주 서버" icon=db badge="RW"
    store cache "캐시" icon=cache badge="RW"
  }
  box vpn "VPN" shape=tile icon=vpn
  box bastion "배스천" shape=tile icon=bastion
}

user -> dns no=1
dns -> cdn no=2
cdn -> lb no=3
lb -> web no=4
web -> app no=5
app -> db no=6
admin -> vpn no=7
vpn -> bastion no=8
bastion -> app no=9
app -> cache

view graph down

scene "요청 경로" mode=static
  user -> dns
  dns -> cdn
  cdn -> lb
  lb -> web
  web -> app
  app -> db
