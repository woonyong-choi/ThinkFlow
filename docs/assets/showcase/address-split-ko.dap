flow down
title "주소 나누기"

grid va "가상 주소 (16비트)" cols=16 {
  item vpn "페이지 번호 (10비트)" col=0 cols=10
  item offset "오프셋 (6비트)" col=10 cols=6
}
grid pa "물리 주소 (16비트)" cols=16 {
  item pfn "프레임 번호 (10비트)" col=0 cols=10
  item offset "오프셋 (6비트)" col=10 cols=6
}
va -> pa "페이지 표 조회"

step "나누기" "윗 10비트는 페이지 번호이고 아랫 6비트는 페이지 안의 위치입니다"
  light va.vpn
  light va.offset
step "바꾸기" "페이지 번호만 프레임 번호로 바뀌고 오프셋은 그대로 갑니다"
  va -> pa "페이지 번호를 프레임 번호로"
  light pa.pfn
  light pa.offset
