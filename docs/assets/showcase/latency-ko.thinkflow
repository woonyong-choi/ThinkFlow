thinkflow
title "캐시를 붙이기 전과 후"
subtitle "엔드포인트마다 같은 요청 1,000건의 p95 지연을 캐시 없이와 캐시를 붙여 잰 값이다"

chart latency "엔드포인트별 p95 지연" dumbbell "예시 데이터. 가로 눈금은 로그" {
  x "p95 지연(ms, 로그 눈금)"
  scale log
  series base "캐시 없음" role=compare
  series cached "캐시 있음" role=main
  row "GET /products" base=480 cached=42
  row "GET /orders" base=650 cached=120
  row "GET /search" base=1800 cached=340
  row "POST /orders" base=420 cached=410
}

scene "전과 후" mode=static
  reveal latency.base
  reveal latency.cached
