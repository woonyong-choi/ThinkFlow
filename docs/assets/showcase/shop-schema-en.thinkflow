thinkflow
title "Shop schema"
subtitle "An order points to its user, and an order item points to its order and product through foreign keys"

table users "users" {
  id bigint pk
  email text unique required
}
table products "products" {
  id bigint pk
  price "numeric(10, 2)" required
}
table orders "orders" {
  id bigint pk
  user_id bigint fk=users.id required ondelete=restrict
  status text required
}
table order_items "order_items" {
  id bigint pk
  order_id bigint fk=orders.id required ondelete=cascade
  product_id bigint fk=products.id required
}

view graph down

scene "Foreign keys" mode=static
  light orders.user_id order_items.order_id order_items.product_id
