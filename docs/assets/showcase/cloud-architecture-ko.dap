flow right
width wide
title "클라우드 구성도"
subtitle "사용자 요청은 DNS와 CDN을 거쳐 로드 밸런서, 웹 서버, 앱 서버, 데이터베이스로(1~6), 관리자는 VPN과 바스천을 거쳐 앱 서버로(7~9) 들어온다"

group users "사용자" icon=user border=dashed {
  box client "웹 사용자" shape=tile icon=desktop
}
group admins "관리자" icon=admin border=dashed direction=down {
  box admin "운영자" shape=tile icon=admin
  box vpn "VPN" shape=tile icon=vpn
}
group net "인터넷" icon=cdn border=dashed direction=down {
  box dns "DNS" shape=tile icon=dns
  box cdn "CDN" shape=tile icon=cdn
  box storage "스토리지" shape=tile icon=object
}
group cloud "클라우드" icon=region {
  group vpc "VPC" icon=vpc border=dashed direction=right {
    group pub "퍼블릭 서브넷" icon=subnet direction=right {
      box lb "로드 밸런서" shape=tile icon=lb
      box bastion "바스천" shape=tile icon=bastion
    }
    group scaling "스케일링 그룹" icon=scaling border=dashed direction=right {
      box web "웹 서버" shape=tile icon=server count=3
    }
    group priv "프라이빗 서브넷" icon=subnet direction=right {
      box app "앱 서버" shape=tile icon=server
      store db "DB 주" icon=db badge="RW"
      store dbro "DB 복제" icon=db badge="RO"
      store cache "캐시 주" icon=cache badge="RW"
      store cachero "캐시 복제" icon=cache badge="RO"
      box mq "메시지 큐" shape=tile icon=mq
    }
  }
}
group ops "운영" icon=monitoring border=dashed direction=down {
  box monitor "모니터링" shape=tile icon=monitoring
  box logs "로그 검색" shape=tile icon=logsearch
}

client -> dns no=1
dns -> cdn no=2
cdn -> lb no=3
lb -> web no=4
web -> app no=5
app -> db no=6
admin -> vpn no=7
vpn -> bastion no=8
bastion -> app no=9
app -> dbro dashed
app -> cache
app -> cachero dashed
app -> mq
cdn -> storage
app -> monitor
app -> logs

step "해석" "도메인이 DNS에서 CDN으로 풀린다"
  client -> dns
  dns -> cdn
step "분산" "CDN이 로드 밸런서로, 로드 밸런서가 웹 서버로 요청을 나눈다"
  cdn -> lb
  lb -> web
step "처리" "웹 서버가 앱 서버를 부르고 앱 서버가 캐시와 큐를 쓴다"
  web -> app
  app -> cache & app -> mq
step "저장" "앱 서버가 DB 주에 쓰고 복제본과 캐시 복제를 읽는다"
  app -> db
  app -> dbro
step "VPN 접속" "관리자가 VPN 게이트웨이에 접속한다"
  admin -> vpn
step "바스천 경유" "VPN에서 바스천을 거쳐 앱 서버에 닿는다"
  vpn -> bastion
  bastion -> app
