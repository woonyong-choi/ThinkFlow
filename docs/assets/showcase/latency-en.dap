daphnis 2
title "Before and after adding a cache"
subtitle "The p95 latency of the same 1,000 requests per endpoint, measured without and with a cache"

chart latency "p95 latency per endpoint" dumbbell "Example data. The horizontal scale is logarithmic" {
  x "p95 latency (ms, log scale)"
  scale log
  series base "No cache" role=compare
  series cached "Cached" role=main
  row "GET /products" base=480 cached=42
  row "GET /orders" base=650 cached=120
  row "GET /search" base=1800 cached=340
  row "POST /orders" base=420 cached=410
}

scene "Before and after" mode=static
  reveal latency.base
  reveal latency.cached
