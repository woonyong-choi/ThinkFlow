{
  "name": "daphnis",
  "version": "0.1.3",
  "description": "Turn one .dap text source into an animated SVG figure for documentation: asynchronous flows, sequences, states, data relations, and charts",
  "license": "MIT",
  "keywords": [
    "diagram",
    "animation",
    "svg",
    "markdown",
    "documentation",
    "simulation",
    "async",
    "sequence-diagram",
    "chart",
    "cli"
  ],
  "author": "choi woo-nyong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woonyong-choi/daphnis.git"
  },
  "homepage": "https://github.com/woonyong-choi/daphnis#readme",
  "bugs": {
    "url": "https://github.com/woonyong-choi/daphnis/issues"
  },
  "type": "module",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "docs/assets/daphnis-*.svg",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "daphnis": "src/cli.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=2 test/*.test.js",
    "grammar": "node scripts/build-grammar-doc.mjs",
    "fuzz": "node scripts/fuzz-layout.mjs",
    "perf": "node scripts/perf-chips.mjs",
    "checkdoc": "node scripts/build-check-doc.mjs",
    "check": "node scripts/check-design.mjs && node src/vendor/theme/ui/build/check-tokens.mjs src --tokens src/vendor/theme/tokens.json",
    "check:sources": "node src/cli.js check examples/*.dap docs/assets/*.dap docs/assets/showcase/*.dap --strict",
    "check:figures": "node scripts/run-md.mjs --check --strict && node scripts/build-showcase.mjs --check",
    "check:advisory": "node scripts/check-cost-comments.mjs --advisory src test && node scripts/check-size.mjs --advisory src scripts",
    "examples": "node scripts/build-catalog.mjs",
    "showcase": "node scripts/build-showcase.mjs",
    "figures": "npm run catalog && node src/cli.js render docs/assets/how-it-works.dap && npm run showcase && node scripts/run-md.mjs",
    "catalog": "npm run examples",
    "design:sync": "node src/vendor/theme/ui/build/sync.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-math": "^0.4.2",
    "elkjs": "^0.9.3",
    "fontkit": "^2.0.4",
    "jetbrains-mono": "^1.0.6",
    "postcss": "8.5.29",
    "pretendard": "^1.3.9",
    "subset-font": "^2.9.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./design-manifest.json": "./src/vendor/theme/manifest.json",
    "./package.json": "./package.json"
  }
}
