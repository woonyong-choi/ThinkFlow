{
  "name": "mutoscope",
  "version": "0.0.0",
  "private": true,
  "description": "문서 그림 문법으로 움직이는 구조 그림과 차트를 만든다",
  "type": "module",
  "bin": {
    "mutoscope": "src/cli.js"
  },
  "scripts": {
    "test": "node --test test/",
    "tokens": "python3 ${SKILLS_DIR:-$HOME/.claude/skills}/design-tokens/scripts/build_tokens.py src/tokens.json --out src",
    "check": "python3 ${SKILLS_DIR:-$HOME/.claude/skills}/design-tokens/scripts/check_tokens.py src && python3 ${SKILLS_DIR:-$HOME/.claude/skills}/code-style/scripts/check_cost_comments.py src test",
    "examples": "node src/cli.js gallery examples --out examples/out --title \"예제\"",
    "screens": "node scripts/screens.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "d2coding": "^1.3.2",
    "elkjs": "^0.9.3",
    "fontkit": "^2.0.4",
    "pretendard": "^1.3.9",
    "subset-font": "^2.9.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
