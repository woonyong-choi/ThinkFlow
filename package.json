{
  "name": "daphnis",
  "version": "0.1.1",
  "description": "Turn one .dap text source into an animated SVG figure for documentation: asynchronous flows, sequences, states, data relations, and charts",
  "license": "MIT",
  "keywords": [
    "diagram",
    "animation",
    "svg",
    "markdown",
    "documentation",
    "simulation",
    "async",
    "sequence-diagram",
    "chart",
    "cli"
  ],
  "author": "choi woo-nyong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woonyong-choi/daphnis.git"
  },
  "homepage": "https://github.com/woonyong-choi/daphnis#readme",
  "bugs": {
    "url": "https://github.com/woonyong-choi/daphnis/issues"
  },
  "type": "module",
  "files": [
    "src",
    "docs/assets/daphnis-*.svg",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "daphnis": "src/cli.js",
    "mutoscope": "src/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "grammar": "node scripts/build-grammar-doc.mjs",
    "fuzz": "node scripts/fuzz-layout.mjs",
    "perf": "node scripts/perf-chips.mjs",
    "checkdoc": "node scripts/build-check-doc.mjs",
    "palette": "node scripts/build-palette.mjs",
    "tokens": "node scripts/build-tokens.mjs src/tokens.json --out src",
    "check": "node scripts/build-tokens.mjs src/tokens.json --check && node scripts/check-tokens.mjs src && node scripts/check-cost-comments.mjs src test && node scripts/check-size.mjs src scripts",
    "examples": "node src/cli.js gallery examples --out examples/out --title \"예제\"",
    "showcase": "node scripts/build-showcase.mjs",
    "figures": "npm run examples && npm run showcase && node src/cli.js render docs/assets/how-it-works.dap && node src/cli.js md $(git grep -l '^```dap' -- '*.md')"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-math": "^0.4.2",
    "elkjs": "^0.9.3",
    "fontkit": "^2.0.4",
    "jetbrains-mono": "^1.0.6",
    "pretendard": "^1.3.9",
    "subset-font": "^2.9.0"
  },
  "devDependencies": {
    "@carbon/colors": "^11.59.0",
    "@woonyong-choi/design-tokens": "github:woonyong-choi/design-tokens#v0.1.1",
    "playwright-core": "^1.63.0"
  }
}
