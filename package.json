{
  "name": "mutoscope",
  "version": "0.0.0",
  "private": true,
  "description": "문서 그림 문법으로 움직이는 구조 그림과 차트를 만든다",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woonyong-choi/mutoscope.git"
  },
  "homepage": "https://github.com/woonyong-choi/mutoscope#readme",
  "bugs": {
    "url": "https://github.com/woonyong-choi/mutoscope/issues"
  },
  "type": "module",
  "bin": {
    "mutoscope": "src/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "grammar": "node scripts/build-grammar-doc.mjs",
    "fuzz": "node scripts/fuzz-layout.mjs",
    "checkdoc": "node scripts/build-check-doc.mjs",
    "tokens": "node scripts/build-tokens.mjs src/tokens.json --out src",
    "check": "node scripts/check-tokens.mjs src && node scripts/check-cost-comments.mjs src test && node scripts/check-size.mjs src scripts",
    "examples": "node src/cli.js gallery examples --out examples/out --title \"예제\"",
    "screens": "node scripts/screens.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-kr": "^0.4.3",
    "@expo-google-fonts/noto-sans-math": "^0.4.2",
    "elkjs": "^0.9.3",
    "fontkit": "^2.0.4",
    "jetbrains-mono": "^1.0.6",
    "subset-font": "^2.9.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
