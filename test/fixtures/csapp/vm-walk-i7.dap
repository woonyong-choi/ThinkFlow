flow right
title "코어 i7 4단계 페이지 테이블 조회"
subtitle "48비트 VA를 VPN1~VPN4와 VPO로 나누고, 단계마다 PTE의 물리 주소로 다음 테이블을 찾는다"

box va "가상 주소 VA" "0x7F3A12345678, 48비트"
box cr3 "CR3 레지스터" "1단계 테이블의 물리 주소"
box pt1 "1단계 테이블" "엔트리 512개"
box pt2 "2단계 테이블" "엔트리 512개"
box pt3 "3단계 테이블" "엔트리 512개"
box pt4 "4단계 테이블" "엔트리 512개"
box pa "물리 주소 PA" "52비트 중 하위 40비트 PPN"
store tlb "TLB" "세트 5에 저장" 

va -> cr3 "VPN1 254"
cr3 -> pt1 "기준 주소"
pt1 -> pt2 "VPN2 232"
pt2 -> pt3 "VPN3 145"
pt3 -> pt4 "VPN4 325"
pt4 -> pa "PPN 0xA1B2"
pa -> tlb "VPN으로 캐시" quiet

step "VA 나누기" "36비트 VPN을 9비트씩 넷으로, 하위 12비트는 VPO로 나눈다"
  light va
  show va "VPN1 비트 47~39 = 254" tag="9비트"
  show va "VPN2 비트 38~30 = 232" tag="9비트"
  show va "VPN3 비트 29~21 = 145" tag="9비트"
  show va "VPN4 비트 20~12 = 325" tag="9비트"
  show va "VPO 비트 11~0 = 0x678" tag="12비트" tone=gray
step "테이블 따라가기" "PTE 하나가 다음 단계 테이블의 물리 주소를 담고 있다"
  va -> cr3 "VPN1 254로 시작"
  cr3 -> pt1 "1단계 주소"
  show pt1 "PTE[254]: P=1, 2단계 주소" tag="L1"
  pt1 -> pt2 "2단계 주소"
  show pt2 "PTE[232]: P=1, 3단계 주소" tag="L2"
  pt2 -> pt3 "3단계 주소"
  show pt3 "PTE[145]: P=1, 4단계 주소" tag="L3"
  pt3 -> pt4 "4단계 주소"
  show pt4 "PTE[325]: P=1, R/W=1, U/S=1" tag="L4"
  show pt4 "물리 페이지 주소 PPN 0xA1B2" tag="L4"
step "PA 만들기" "4단계 PTE의 PPN에 VPO를 이어 붙이고 TLB에도 적어 둔다"
  pt4 -> pa
  show pa "PA = PPN 0xA1B2, PPO 0x678" tag="PA" tone=green
  show pa "0xA1B2678" tag="PA" tone=green mono
  pa -> tlb "태그 0x7F3A1234"
  show tlb "TLBT 0x7F3A1234 → PPN 0xA1B2" tag="fill" tone=purple
