flow right
title "생산자와 소비자: 유한 버퍼"
subtitle "버퍼 4칸. slots는 빈 칸 수, items는 찬 칸 수, mutex는 버퍼 접근 잠금"
aspect 1.6

box producer "생산자" "item을 만들어 삽입"
box consumer "소비자" "item을 꺼내 소비"
box slots "slots" "빈 칸 세마포어, 초기 4"
box mutex "mutex" "잠금, 초기 1"
box buf "sbuf 버퍼" "n = 4, front = 0, rear = 0"
box items "items" "찬 칸 세마포어, 초기 0"

producer -> slots "P"
producer -> mutex "P, V"
producer -> buf "insert"
producer -> items "V"
consumer -> items "P"
consumer -> mutex "P, V"
consumer -> buf "remove"
consumer -> slots "V"

step "삽입 두 번" "생산자가 slots를 줄이고 칸에 넣은 뒤 items를 올린다"
  producer -> slots "P(slots) 4에서 3"
  show slots "4 → 3" tag="P"
  producer -> mutex "P(mutex) 잠금"
  producer -> buf "insert 7"
  show buf "[ 7, _, _, _ ] rear = 1" tag="insert"
  producer -> mutex "V(mutex) 풀기"
  producer -> items "V(items) 0에서 1"
  show items "0 → 1" tag="V"
  producer -> slots "P(slots) 3에서 2"
  show slots "3 → 2" tag="P"
  producer -> buf "insert 9"
  show buf "[ 7, 9, _, _ ] rear = 2" tag="insert"
  producer -> items "V(items) 1에서 2"
  show items "1 → 2" tag="V"
step "가득 차서 대기" "slots가 0이면 생산자의 P가 소비자의 V를 기다린다"
  producer -> buf "insert 3, 5"
  show buf "[ 7, 9, 3, 5 ] rear = 0" tag="가득 참" tone=gray
  show slots "0, 생산자 P 대기" tag="대기" tone=gray
  show items "4" tag="V"
step "소비" "소비자가 칸을 비우면 V(slots)가 대기 중인 생산자를 깨운다"
  consumer -> items "P(items) 4에서 3"
  show items "4 → 3" tag="P"
  consumer -> mutex "P(mutex) 잠금"
  consumer -> buf "remove, 7을 꺼냄"
  show buf "[ _, 9, 3, 5 ] front = 1" tag="remove"
  consumer -> mutex "V(mutex) 풀기"
  consumer -> slots "V(slots) 0에서 1"
  show slots "0 → 1, 생산자 깨움" tag="V" tone=green
