data right
title "주소 비트 분할과 번역 표"
subtitle "14비트 VA, 12비트 PA, 페이지 64바이트인 작은 시스템. VA 0x03D4가 PA 0x354로 바뀐다"

table va_14 "VA 14비트" {
  VPN "비트 13~6, 8비트" pk
  VPO "비트 5~0, 6비트"
}
table tlb_set "TLB 4-way, 4세트" {
  TLBT "VPN 상위 6비트"
  TLBI "VPN 하위 2비트"
  PPN "6비트" fk=pa_12.PPN
  Valid "1비트"
}
table page_table "페이지 테이블" {
  VPN "8비트" fk=va_14.VPN
  PPN "6비트" fk=pa_12.PPN
  Valid "1비트"
}
table pa_12 "PA 12비트" {
  PPN "비트 11~6, 6비트" pk
  PPO "비트 5~0, 6비트"
}
table cache_view "L1 캐시, 직접 사상" {
  CT "비트 11~6, 태그"
  CI "비트 5~2, 인덱스"
  CO "비트 1~0, 블록 오프셋"
}

step "VA 나누기" "0x03D4 = 00 0011 1101 0100을 VPN 0x0F와 VPO 0x14로 나눈다"
  light va_14.VPN va_14.VPO
  show va_14 "0x03D4 = 0b00001111 010100" mono
  show va_14 "VPN 0x0F, VPO 0x14" tag="split"
step "TLB 적중" "VPN 0x0F의 하위 2비트 3이 세트, 상위 6비트 0x03이 태그다"
  light tlb_set.TLBT tlb_set.TLBI
  show tlb_set "세트 3, 태그 0x03" tag="TLB"
  show tlb_set "PPN 0x0D, 유효 1" tag="hit" tone=green
  va_14 -> page_table
  show page_table "PTE 0x0F: PPN 0x0D, 유효 1" tag="PTE"
step "PA 만들기" "PPN 0x0D와 PPO 0x14를 이으면 PA 0x354이고, 캐시에서는 다르게 나눈다"
  page_table -> pa_12
  show pa_12 "PPN 0x0D, PPO 0x14" tag="PA"
  show pa_12 "0x354 = 0b001101 010100" mono
  light cache_view.CT cache_view.CI cache_view.CO
  show cache_view "CT 0x0D, CI 5, CO 0" tag="hit" tone=green
  show cache_view "바이트 0x36" tag="data"
