sequence
title "함수 호출과 복귀 순서"
subtitle "main이 caller를, caller가 swap_add를 부른다. call이 반환 주소를 push하고 ret이 pop한다"

box main "main" "호출자"
box caller "caller" "프레임 포인터 사용"
box swap "swap_add" "리프 함수"
store regs "레지스터" "rsp, rbp, rdi, rsi, rax"
store stack "런타임 스택" "높은 주소에서 낮은 주소로 자람"

step "caller 호출" "call이 반환 주소를 push하고, 피호출자가 이전 rbp를 저장한 뒤 프레임을 만든다"
  main -> caller "call, 0x401156 push"
  note caller "rsp = 0x7FFFE008"
  caller -> stack "push %rbp (0x7FFFE020)"
  note stack "rsp = 0x7FFFE000"
  caller -> regs "mov %rsp,%rbp"
  note regs "rbp = 0x7FFFE000"
  caller -> stack "sub $16,%rsp; arg1 534, arg2 1057"
  note stack "rsp = 0x7FFFDFF0"
step "swap_add 호출" "포인터 두 개를 인자 레지스터로 넘기고 call로 제어를 옮긴다"
  caller -> regs "rdi = &arg1, rsi = &arg2"
  note regs "rdi 0x7FFFDFF0, rsi 0x7FFFDFF8"
  caller -> swap "call, 0x401172 push"
  note swap "rsp = 0x7FFFDFE8"
  swap -> stack "push %rbp (0x7FFFE000)"
  swap -> stack "x = 534, y = 1057"
  swap -> stack "*rdi = y, *rsi = x + y"
  swap -> regs "rax = 1591"
step "복귀" "leave와 ret이 rsp와 rbp를 호출 전 값으로 되돌린다"
  swap -> caller "pop %rbp; ret 0x401172" dashed
  note swap "rsp = 0x7FFFDFF0"
  caller -> regs "rax = -849594"
  caller -> main "leave; ret 0x401156" dashed
  note caller "rsp = 0x7FFFE010"
