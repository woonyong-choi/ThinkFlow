mutoscope 1
flow right
title "구조 그림의 모든 낱말"
subtitle "사람, 상자, 외부, 저장소, 갈림길, 그룹, 선과 카드 줄의 모든 선택 사항"
speed 1s
aspect 1.0

person user "사용자"
box api "API" "게이트웨이"
external ext "결제사" "외부 서비스"
store db "원장" "데이터베이스"
decision ok "승인됐나"
group core "코어" direction=down {
  box a "서비스 A"
  box b "서비스 B"
}

user -> api "요청"
api -> ext "승인 요청" dashed
api -> db "저장" quiet
ext -> ok
ok -> core "예"
api -> a
a -> b "전달" quiet dashed

step "첫 단계" "모든 박자 줄"
  user -> api "요청 본문" time=2s
  api -> ext "승인" & api -> db "기록" time=1s
  show api "접수" tag="in" tone=teal meta="2건" mark="✓" mono
  show db graph "a -> b; a -> c" lit="a"
  clear api
  light api ok
  say "여기까지 한 단계"
  wait 1s
step "둘째 단계"
  api -> a
  a -> b "전송"
  show db "기록" tag="log" tone=gray
  show ext "응답" tag="ok" tone=green
  show user "화면" tag="ui" tone=purple
