mutoscope 1
state right
title "상태 그림의 모든 낱말"
subtitle "상태, 그룹, 처음과 끝, 전이의 선택 사항"
speed 1s
aspect 1.6

state idle "대기"
state run "실행"
state done "완료"
group extra "예외" direction=down {
  state failed "실패"
}
start idle
final done
idle -> run "시작"
run -> done "끝" quiet
run -> run "재시도" dashed
run -> failed "오류"

step "정상 흐름"
  idle -> run
  light run
  say "실행 중"
  run -> done
  wait 1s
