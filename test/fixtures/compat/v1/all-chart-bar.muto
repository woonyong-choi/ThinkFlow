mutoscope 1
chart bar
title "막대 차트의 모든 낱말"
subtitle "예시 데이터. 역할, 키, 기준선, 빠진 값, 신뢰구간, 단계"
speed 1s
x "정확도(%)"
scale linear
series ours "기억 붙임" role=main key="ours"
series base "기억 없음" role=compare
rule 50 "기준"
missing "측정 안 함"
row "A" ours=80 ours.low=70 ours.high=90 base=50
row "B" ours=60 base=-
step "없음"
  reveal base
step "붙임" "기억을 붙이면"
  reveal ours
  light "A"
  say "차이가 난다"
  wait 1s
