mutoscope 1
flow right
width wide
title "번호, 배지, 아이콘, 복제 개수, 타일, 점선 테두리의 모든 낱말"
subtitle "no, badge, icon, icons, count, shape=tile, border"

icons mine "architecture-icons"
group edge "엣지" border=solid badge="NET" icon=region {
  box lb "로드 밸런서" icon=lb badge="LB"
}
group app "앱" border=dashed direction=down {
  box web "웹" icon=server badge="WEB" count=3
  box chip "칩" shape=tile icon=mine:chip
  box vcs "저장소" icon=builtin:db
}
lb -> web "요청" no=1
web -> chip no=2
chip -> vcs "저장" no=3
