mutoscope 1
flow right
title "브랜드 파랑과 빨강 tone"
subtitle "tone에 brand와 red를 쓴다. brand는 브랜드 파랑, red는 오류"

box a "A"
box b "B"
box c "C"
a -> b "요청"
b -> c "응답"

step "접수" "brand와 red 태그"
  show a "정상" tag="ok" tone=brand
  show b "오류" tag="err" tone=red
step "흐름" for=4s
  track a -> b -> c every=2s tone=brand
  track b -> c every=2s tone=red
