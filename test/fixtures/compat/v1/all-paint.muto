mutoscope 1
flow right
title "면과 테두리 색의 모든 낱말"
subtitle "도형과 그룹의 fill, stroke와 카드 줄의 card에 쓰는 색 이름 전부"

person user "사용자" fill=pink stroke=pink
box api "API" "게이트웨이" fill=amber stroke=amber
external ext "결제사" "외부 서비스" fill=navy stroke=navy
store db "원장" "데이터베이스" fill=teal stroke=teal
group core "코어" fill=gray stroke=gray {
  box a "서비스 A" fill=green stroke=green
  box b "서비스 B" fill=red
}
group edge-zone "가장자리" stroke=purple {
  box c "서비스 C" stroke=red
}

user -> api "요청"
api -> ext "승인 요청"
api -> db "저장"
api -> a
a -> b "전달"
b -> c

step "첫 단계" "카드 바탕 색"
  user -> api "요청 본문"
  show api "접수" tag="in" card=amber
  show db "기록" card=teal
  light core
step "둘째 단계"
  api -> a
  show a "처리" card=green
  show b "응답" card=red
  show ext "확인" card=navy
  show user "화면" card=pink
  show c "마감" card=purple
  show db "정리" card=gray
